# Bitwise operations on natural numbers (bitstrings, LSB-first).
# The implementation lives in Nat (Nat.xor/bit_and/bit_or); these are the
# Qr-facing names.
xor = Nat.xor
bit_and = Nat.bit_and
bit_or = Nat.bit_or

# Shift left by n (multiply by 2^n): Nat.shl prepends n zero low bits; zero is
# passed through so it does not pick them up as padding.
shl = \n \x Bool.match (Nat.shl n x) x $ Nat.is_zero x

# Shift right by n (integer divide by 2^n) — drop n LSBs. Nat.shr preserves
# canonical form; it does not repair already-padded input (neither did the
# previous spelling here: it applied Nat.canonicalize to the dropping function
# rather than composing with it, which happens to reduce to the function
# unchanged — so callers never got re-canonicalization from this symbol).
shr = Nat.shr

# Test if bit at position i is set (0-indexed from LSB)
bit_test = List.nth

# Pad a number (LSB-first) to exactly w bits, truncating if longer
_pad_to = \w \n List.take w $ List.concat n $ List.repeat w false

# Pad a number to exactly 8 bits
byte = _pad_to 8

# Convert a list of booleans (MSB-first) to a natural number
from_msb = List.foldl (\acc \bit Bool.match (Nat.double acc) (Nat.succ $ Nat.double acc) bit) 0

# Convert a natural number to a list of booleans (MSB-first), padded to given width
to_msb = \width \n List.reverse $ _pad_to width n

# Tests
_to_string = Nat.to_source
xor 5 3
# = 6
xor 255 255
# = 0
xor 0 42
# = 42
xor 42 0
# = 42
bit_and 5 3
# = 1
bit_and 255 0
# = 0
bit_or 5 3
# = 7
bit_or 0 0
# = 0
shl 1 5
# = 10
shl 3 1
# = 8
shr 1 10
# = 5
shr 2 12
# = 3
from_msb [true; false; true]
# = 5
from_msb [true; true; true; true]
# = 15
