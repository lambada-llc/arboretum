# QR code SVG rendering
# Renders any square grid of 0/1 values as an SVG image with quiet zone.
# Built on the Xml/Svg primitives so attribute/element encoding lives in one place.

_quiet = 4
_scale = 4
_q = 34

_prolog = List.concat "<?xml version=" $ List.concat [_q; '1'; '.'; '0'; _q] "?>"

_offset = \i Nat.to_string (Nat.add (Nat.mul _quiet _scale) (Nat.mul i _scale))

_cell = \x \y Xml.element "rect"
  [△ "x" (_offset x); △ "y" (_offset y);
   △ "width" (Nat.to_string _scale); △ "height" (Nat.to_string _scale);
   △ "fill" "black"] []

# Render a QR grid to SVG string. Size is taken from the grid.
qr_to_svg = \grid
  let (Qr.grid_height grid) $ \s
  let (Nat.to_string (Nat.mul (Nat.add (Nat.mul 2 _quiet) s) _scale)) $ \sz
  List.concat _prolog
  $ Xml.element "svg"
      [△ "xmlns" "http://www.w3.org/2000/svg";
       △ "viewBox" (List.join " " ["0"; "0"; sz; sz])]
  $ △ (Svg.background "white")
      (List.concat_list $ Qr.grid_mapi (\x \y \val Bool.match "" (_cell x y) (equal val 1)) grid)

_to_string = id
△ (△ "hi.svg" "image/svg+xml") $ qr_to_svg $ Qr.qr "Hi"
# = hi.svg sha256:9eb3037043199e04c52b6096fafd80376e7deca754fb206521aae1603bc980ef
△ (△ "url.svg" "image/svg+xml") $ qr_to_svg $ Qr.qr "https://treecalcul.us/"
# = url.svg sha256:a78fda005d030f7fd689e1c165e237aa66d4bbb7c0af0ea46a69ab410d498647
