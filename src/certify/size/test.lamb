# Tests for the size certifier in src/certify/size.
#
# They are a file of their own because the analysis is applied where the
# programs it judges are defined: src/snat/size.lamb certifies its size programs
# there, and so depends on Certify.Size.computes_size. Dependencies are per file and
# cycles are rejected, so the analysis cannot also be the file that reaches back
# into Snat. What belongs here is the rest — size written in styles the library
# does not use, and programs that are not size at all.

# Size written in styles that reduce differently.
# Direct structural recursion: 1 + (|a| + |b|).
_naive = fix $ \self triage Snat.one (\a Snat.succ (self a)) (\a \b Snat.succ (Snat.add (self a) (self b)))
# Same, with the two subtree counts added the other way round.
_swapped = fix $ \self triage Snat.one (\a Snat.succ (self a)) (\a \b Snat.succ (Snat.add (self b) (self a)))
# Same, with the successor pushed inside the addition: |a| + (1 + |b|).
_shifted = fix $ \self triage Snat.one (\a Snat.succ (self a)) (\a \b Snat.add (self a) (Snat.succ (self b)))
# Accumulator passing: no addition at all, the count is threaded through.
_accumulating = \x (fix $ \self \x \n triage
  (Snat.succ n) (\a Snat.succ (self a n)) (\a \b Snat.succ (self b (self a n))) x) x Snat.zero

_to_string = Bool.to_source
Certify.Size.computes_size _naive
# = true
Certify.Size.computes_size _swapped
# = true
Certify.Size.computes_size _shifted
# = true
Certify.Size.computes_size _accumulating
# = true

# A true is backed by a proof tree that can be looked at: SPLIT with a case
# per shape of the split variable, PEEL per emitted successor, GEN naming a
# subterm's count, CUT opening a phase against a tail that END closes, FOLD
# closing an instance of an induction hypothesis.
_to_string = Option.match "no proof" Certify.Size.render
Certify.Size.certify_size _naive
# = SPLIT t
#     PEEL
#       ZERO
#     GEN g1
#       PEEL
#         VALUE g1
#     GEN g2
#       GEN g3
#         CUT [g2]
#           PEEL
#             SPLIT g3
#               END
#               PEEL
#                 FOLD
#           VALUE g2
_to_string = Bool.to_source

# The same four in the stronger reading: `size` whatever the reduction order,
# so none of them leans on a rule discarding a subterm before it is reduced.
Certify.Size.computes_size_eagerly _naive
# = true
Certify.Size.computes_size_eagerly _swapped
# = true
Certify.Size.computes_size_eagerly _shifted
# = true
Certify.Size.computes_size_eagerly _accumulating
# = true

# Programs that are not size, and are rejected.
_leaves = fix $ \self triage Snat.one (\a self a) (\a \b Snat.add (self a) (self b))
_left_spine = fix $ \self triage Snat.one (\a Snat.succ (self a)) (\a \b Snat.succ (self a))
_off_by_one = compose Snat.succ Snat.size
# `size`, except a fork's right child counts one too many when it is a stem. It
# agrees with `size` on all four trees of up to three nodes, and the smallest
# input that separates them is [△ △ (△ △)] — so sampling small inputs accepts
# it, while reading it under an arbitrary tree does not.
_deep_bug = fix $ \self triage Snat.one (\a Snat.succ (self a)) (\a \b Snat.succ $ Snat.add (self a) $
  triage Snat.one (\c Snat.succ $ Snat.succ (self c)) (\c \d Snat.succ $ Snat.add (self c) (self d)) b)

Certify.Size.computes_size _leaves
# = false
Certify.Size.computes_size _left_spine
# = false
Certify.Size.computes_size _off_by_one
# = false
Certify.Size.computes_size _deep_bug
# = false
# The disagreement, from four nodes up:
_to_string = Snat.to_string
_deep_bug (△ △ △)
# = 3
Snat.size (△ △ △)
# = 3
_deep_bug (△ △ (△ △))
# = 5
Snat.size (△ △ (△ △))
# = 4

_to_string = Bool.to_source
Certify.Size.computes_size id
# = false
Certify.Size.computes_size Snat.add
# = false

# Conservative, not wrong: this is size, but it counts in binary Nat and
# converts only at the end, so the induction never closes over the unary spec.
Certify.Size.computes_size (compose Snat.from_nat size)
# = false

# The eager reading adds a way to fail and takes none away, so everything above
# is rejected here too — and a false still means "not certifiable" rather than
# "diverges": the binary-counting one terminates in every order and is rejected
# for the reason it always was.
Certify.Size.computes_size_eagerly _leaves
# = false
Certify.Size.computes_size_eagerly _deep_bug
# = false
Certify.Size.computes_size_eagerly (compose Snat.from_nat size)
# = false

# Recursion on a rebuilt tree, right and wrong. A chain step counts a fork's
# left child by stacking it onto the right child — self u v reduces to △ⁿ v —
# and recursing on that chain, which is no subtree of the input. The eager
# certifier's size-measure rules close the real one, and the accounting
# rejects the mutants: counting u twice needs parts that are not disjoint,
# dropping v leaves a size the spec still owes unmatched, and a missing
# successor leaves a 1 unpaid.
_chain = \x (fix $ \self \x compose Snat.succ $ triage id self (\u \v self (self u v)) x) x △
_chain_twice = \x (fix $ \self \x compose Snat.succ $ triage id self (\u \v self (self u u)) x) x △
_chain_dropped = \x (fix $ \self \x compose Snat.succ $ triage id self (\u \v self (self u △)) x) x △
_chain_unpaid = \x (fix $ \self \x triage id self (\u \v self (self u v)) x) x △
Certify.Size.computes_size_eagerly _chain
# = true
Certify.Size.computes_size_eagerly _chain_twice
# = false
Certify.Size.computes_size_eagerly _chain_dropped
# = false
Certify.Size.computes_size_eagerly _chain_unpaid
# = false

# The same family under the lazy judgment, now that RGEN and GEN-TREE are
# ported there: the real one closes identically — residual for the
# accumulator seat, a minted tree for the chain — and the accounting
# rejects the mutants for the same reasons as above.
Certify.Size.computes_size _chain
# = true
Certify.Size.computes_size _chain_twice
# = false
Certify.Size.computes_size _chain_dropped
# = false
Certify.Size.computes_size _chain_unpaid
# = false

# The record pair's near-siblings, from the search neighborhood #55 mapped:
# the 90 with the 78's narrower pruning seated (87 nodes), and with the
# door's carried copy handed on bare (89 nodes). Both miscount — on some
# input their normal form is not an Snat at all — and reduction is
# confluent, so they are wrong in every order. REL must refuse them: the
# co-reduction their certificates would need never meets, and the use
# obligations never close.
_pruned_90 = Serialize.ternary_decode "212120220021211000121202120112011220021201002121200121100212120001011202200212201000200"
_doored_90 = Serialize.ternary_decode "21212022002121000121202120112011220021110211002121200121100212120001011202200212201000200"
Certify.Size.computes_size _pruned_90
# = false
Certify.Size.computes_size _doored_90
# = false
Certify.Size.computes_size_eagerly _pruned_90
# = false
Certify.Size.computes_size_eagerly _doored_90
# = false

# The lag pair's near-siblings, carved the same way: two single-position
# mutations of the 108's assembly that still converge in normal order but
# return the wrong count on some probe input — one subtle (three of seven),
# one blunter. USE∀ must refuse them: the seat-polymorphic obligations are
# false of the machines they describe, and its leaf case's own arithmetic —
# one wrap, one count, the bare seat — is exactly where a miscounting
# sibling misses.
_shifted_108 = Serialize.ternary_decode "21212021110102021202120112011200212120012110021212021202120001021202120001120212021200010102121000210200"
_pruned_108 = Serialize.ternary_decode "2121202111010202120212011201120021212001200212120212021200010212021200011202120212000101120102121000210200"
Certify.Size.computes_size _shifted_108
# = false
Certify.Size.computes_size _pruned_108
# = false
Certify.Size.computes_size_eagerly _shifted_108
# = false
Certify.Size.computes_size_eagerly _pruned_108
# = false
