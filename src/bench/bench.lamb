# A cost record is a list of eight counters in column order
# [0a; 0b; 1; 2; 3a; 3b; 3c; oh]: the two allocation rules (0a stem, 0b fork),
# the five reduction rules (1 K, 2 S, 3a/3b/3c triage), and last the overhead —
# work that went into results a K-like function then discarded.
#
# The reduction itself is Reflect.evaluator, the annotated eager reducer every
# other measurement in this repository is also an instance of; a table is that
# evaluator run with the annotation A = (record transformer, reductions
# charged). The transformer is `_add subtotal`, where the subtotal is the
# rule's own one-rule delta plus the transformers of the reductions it
# recursed into. _add sums two records pointwise and keeps the longer tail,
# treating the missing one as zeros — so a delta is written sparsely, stopping
# right after its rule's slot, and only _extract pads to all eight against
# _base. The charged count travels alongside because rule 2 needs it: when the
# left result is K-like, the right one's reductions were spent on something
# discarded, so they move to the overhead column and leave the total.
# Versus the previous CPS-record harness (an eight-field consumer lambda
# spelled out per rule, three hand-written merges), meta-benching each harness
# running [Nat.add; 127; 127] puts the trade at half the reduced tree (92106
# -> 45377 nodes) for ~11% more self-reductions (2.97M -> 3.31M) — bookkeeping
# no table records, so every measured output is identical.
_base = [0; 0; 0; 0; 0; 0; 0; 0]
_add = fix $ \self \a \b
    List.match b (\ha \ta List.match a (\hb \tb △ (Nat.add ha hb) (self ta tb)) b) a

_extract = \cost_data Pair.let cost_data $ \cost \_l
    let (cost _base) $ \totals
    let (List.take 7 totals) $ \counts
    List.concat [Nat.to_string (List.nth_or 0 7 totals); "|"] $
    List.concat (List.map Nat.to_string counts)
      ["|"; Nat.to_string (Nat.sum (List.take 2 counts)); Nat.to_string (Nat.sum (List.drop 2 counts))]

# The annotation of a rule that fires once and recurses into nothing.
_rule = \delta △ (_add delta) 1
# Is this result a K — △ △ y, which drops the argument it is about to be
# handed, along with everything that went into computing it?
_is_k = triage false (\_ false) (\x \_ triage true (\_ false) (\_ \_ false) x)

# One application, measured: its result paired with the table row for it.
_run_one = Reflect.evaluator (\result \cost_data △ result (_extract cost_data))
    (_rule [1])
    (_rule [0; 1])
    (_rule [0; 0; 1])
    (\r1 \a1 \a2 \a
        Pair.let a1 $ \c1 \l1
        Pair.let a2 $ \c2 \l2
        Pair.let a  $ \c  \l
        let (_is_k r1) $ \is_k
        △ (_add $ c1 $ c2 $ c [0; 0; 0; 1; 0; 0; 0; Bool.match 0 l2 is_k])
          (Nat.succ (Nat.add l1 (Nat.add (Bool.match l2 0 is_k) l))))
    (_rule [0; 0; 0; 0; 1])
    (\a Pair.let a $ \c \l
        △ (_add $ c [0; 0; 0; 0; 0; 1]) (Nat.succ l))
    (\a1 \a2
        Pair.let a1 $ \c1 \l1
        Pair.let a2 $ \c2 \l2
        △ (_add $ c1 $ c2 [0; 0; 0; 0; 0; 0; 1]) (Nat.succ (Nat.add l1 l2)))

# One row per argument, each measuring the application of what the row above
# reduced to — which the evaluator already handed back, so no application is
# reduced twice.
_collect = fix $ \self \current List.match
    []
    (\next \rest Pair.let (_run_one current next) $ \result \row
        △ row (self result rest))

_header = ["oh"; "|"; "0a"; "0b"; "1"; "2"; "3a"; "3b"; "3c"; "|"; "alc"; "red"]

_widths = List.foldr
    (\row \acc List.zip_with (\a \s Nat.max a (List.length s)) acc row)
    (List.repeat (List.length _header) 0)

_format_table = \rows
    let (△ _header rows) $ \all_rows
    let (_widths all_rows) $ \widths
    List.join "\n"
      (List.map (\row List.join " " (List.zip_with (\w String.pad_left w ' ') widths row)) all_rows)

run = List.match "" $ \hd \tl
    let (_collect hd tl) $ \rows
    List.match "" (\_ \_ _format_table rows) rows

_exercise_all_rules = \tt △ (△ (△ (△ (△ tt △)))) △ (△ (△ △ △)) △
_exercise_all_rules_n = fix $ \self Nat.match (△ △) (\pred _exercise_all_rules $ self pred)
run [_exercise_all_rules; △ △]
# = oh | 0a 0b 1  2 3a 3b 3c | alc red
#    0 | 10  8 9 13  1  1  1 |  18  25
run [_exercise_all_rules_n; 0]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    1 |  6  8 11 12  1  0  1 |  14  25
run [_exercise_all_rules_n; 1]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    3 | 23 27 39 43  3  2  5 |  50  92
run [_exercise_all_rules_n; 10]
# = oh |  0a  0b   1   2 3a 3b 3c | alc red
#   37 | 198 272 359 398 23 20 55 | 470 855
run [_exercise_all_rules_n; 100]
# =  oh |   0a   0b    1    2  3a  3b  3c |  alc  red
#   395 | 1993 2866 3676 4074 205 200 591 | 4859 8746
