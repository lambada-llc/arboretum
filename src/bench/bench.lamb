# A cost record is a list of eight counters in column order
# [0a; 0b; 1; 2; 3a; 3b; 3c; oh]: the two allocation rules (0a stem, 0b fork),
# the five reduction rules (1 K, 2 S, 3a/3b/3c triage), and last the overhead —
# work that went into results a K-like function then discarded. Each _eval case
# pairs its result with a record transformer `_add subtotal`, where the subtotal
# is the case's own one-rule delta plus the child transformers applied to it.
# _add sums two records pointwise and keeps the longer tail, treating the
# missing one as zeros — so a delta is written sparsely, stopping right after
# its rule's slot, and only _extract pads to all eight against _base.
# Versus the previous CPS-record harness (an eight-field consumer lambda
# spelled out per rule, three hand-written merges), meta-benching each harness
# running [Nat.add; 127; 127] puts the trade at half the reduced tree (92106
# -> 45434 nodes) for ~12% more self-reductions (2.97M -> 3.33M) — bookkeeping
# no table records, so every measured output is identical.
_base = [0; 0; 0; 0; 0; 0; 0; 0]
_add = fix $ \self \a \b
    List.match b (\ha \ta List.match a (\hb \tb △ (Nat.add ha hb) (self ta tb)) b) a

_eval = fix $ \self
    triage
      (\z △ (△ z) (△ (_add [1]) 1))
      (\y \z △ (△ y z) (△ (_add [0; 1]) 1))
      (triage
        (\y \z △ y (△ (_add [0; 0; 1]) 1))
        (\x \y \z
          Pair.let (self x z) $ \r1 \cd1 Pair.let cd1 $ \c1 \l1
          Pair.let (self y z) $ \r2 \cd2 Pair.let cd2 $ \c2 \l2
          Pair.let (self r1 r2) $ \r \cd  Pair.let cd  $ \c  \l
          let (triage false (\_ false) (\xx \_ triage true (\_ false) (\_ \_ false) xx) r1) $ \is_k
          △ r (△
            (_add $ c1 $ c2 $ c [0; 0; 0; 1; 0; 0; 0; Bool.match 0 l2 is_k])
            (Nat.succ (Nat.add l1 (Nat.add (Bool.match l2 0 is_k) l)))))
        (\w \x \y \z
          triage
            (△ w (△ (_add [0; 0; 0; 0; 1]) 1))
            (\a
                Pair.let (self x a) $ \r \cd Pair.let cd $ \c \l
                △ r (△ (_add $ c [0; 0; 0; 0; 0; 1]) (Nat.succ l)))
            (\a \b
                Pair.let (self y a) $ \r  \cd1 Pair.let cd1 $ \c1 \l1
                Pair.let (self r b) $ \r  \cd2 Pair.let cd2 $ \c2 \l2
                △ r (△ (_add $ c1 $ c2 [0; 0; 0; 0; 0; 0; 1]) (Nat.succ (Nat.add l1 l2))))
            z))

_extract = \cost_data Pair.let cost_data $ \cost \_l
    let (cost _base) $ \totals
    let (List.take 7 totals) $ \counts
    List.concat [Nat.to_string (List.nth_or 0 7 totals); "|"] $
    List.concat (List.map Nat.to_string counts)
      ["|"; Nat.to_string (Nat.sum (List.take 2 counts)); Nat.to_string (Nat.sum (List.drop 2 counts))]

_collect = fix $ \self \current List.match
    []
    (\next \rest
        triage _ _ (\_ \cost_data △ (_extract cost_data) (self (current next) rest))
        $ _eval current next
    )

_header = ["oh"; "|"; "0a"; "0b"; "1"; "2"; "3a"; "3b"; "3c"; "|"; "alc"; "red"]

_widths = List.foldr
    (\row \acc List.zip_with (\a \s Nat.max a (List.length s)) acc row)
    (List.repeat (List.length _header) 0)

_format_table = \rows
    let (△ _header rows) $ \all_rows
    let (_widths all_rows) $ \widths
    List.join "\n"
      (List.map (\row List.join " " (List.zip_with (\w String.pad_left w ' ') widths row)) all_rows)

run = List.match "" $ \hd \tl
    let (_collect hd tl) $ \rows
    List.match "" (\_ \_ _format_table rows) rows

_exercise_all_rules = \tt △ (△ (△ (△ (△ tt △)))) △ (△ (△ △ △)) △
_exercise_all_rules_n = fix $ \self Nat.match (△ △) (\pred _exercise_all_rules $ self pred)
run [_exercise_all_rules; △ △]
# = oh | 0a 0b 1  2 3a 3b 3c | alc red
#    0 | 10  8 9 13  1  1  1 |  18  25
run [_exercise_all_rules_n; 0]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    1 |  6  8 11 12  1  0  1 |  14  25
run [_exercise_all_rules_n; 1]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    3 | 23 27 39 43  3  2  5 |  50  92
run [_exercise_all_rules_n; 10]
# = oh |  0a  0b   1   2 3a 3b 3c | alc red
#   37 | 198 272 359 398 23 20 55 | 470 855
run [_exercise_all_rules_n; 100]
# =  oh |   0a   0b    1    2  3a  3b  3c |  alc  red
#   395 | 1993 2866 3676 4074 205 200 591 | 4859 8746
