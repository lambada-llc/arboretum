_base = \f f 0 0 0 0 0 0 0 0

_eval = fix $ \self
    triage
      (\z △ (△ z) (△
        (\f f $ \as \af \nk \ns \t1 \t2 \t3 \oh \f f (Nat.succ as) af nk ns t1 t2 t3 oh)
        1))
      (\y \z △ (△ y z) (△
        (\f f $ \as \af \nk \ns \t1 \t2 \t3 \oh \f f as (Nat.succ af) nk ns t1 t2 t3 oh)
        1))
      (triage
        (\y \z △ y (△
          (\f f $ \as \af \nk \ns \t1 \t2 \t3 \oh \f f as af (Nat.succ nk) ns t1 t2 t3 oh)
          1))
        (\x \y \z
          Pair.let (self x z) $ \r1 \cd1 Pair.let cd1 $ \c1 \l1
          Pair.let (self y z) $ \r2 \cd2 Pair.let cd2 $ \c2 \l2
          Pair.let (self r1 r2) $ \r \cd  Pair.let cd  $ \c  \l
          let (triage false (\_ false) (\xx \_ triage true (\_ false) (\_ \_ false) xx) r1) $ \is_k
          let (Bool.match 0 l2 is_k) $ \extra_oh
          let (Nat.succ (Nat.add l1 (Nat.add (Bool.match l2 0 is_k) l))) $ \new_l
          △ r (△
            ((c1 $ c2 $ c _base) $ \a \b \k \n \u1 \u2 \u3 \h
              \f f $ \as \af \nk \ns \t1 \t2 \t3 \oh
                \f f (Nat.add as a) (Nat.add af b) (Nat.add nk k) (Nat.succ (Nat.add ns n)) (Nat.add t1 u1) (Nat.add t2 u2) (Nat.add t3 u3) (Nat.add oh (Nat.add h extra_oh)))
            new_l))
        (\w \x \y \z
          triage
            (△ w (△
              (\f f $ \as \af \nk \ns \t1 \t2 \t3 \oh \f f as af nk ns (Nat.succ t1) t2 t3 oh)
              1))
            (\a
                Pair.let (self x a) $ \r \cd Pair.let cd $ \c \l
                △ r (△
                  ((c _base) $ \a \b \k \n \u1 \u2 \u3 \h
                    \f f $ \as \af \nk \ns \t1 \t2 \t3 \oh
                      \f f (Nat.add as a) (Nat.add af b) (Nat.add nk k) (Nat.add ns n) (Nat.add t1 u1) (Nat.succ (Nat.add t2 u2)) (Nat.add t3 u3) (Nat.add oh h))
                  (Nat.succ l)))
            (\a \b
                Pair.let (self y a) $ \r  \cd1 Pair.let cd1 $ \c1 \l1
                Pair.let (self r b) $ \r  \cd2 Pair.let cd2 $ \c2 \l2
                △ r (△
                  ((c1 $ c2 _base) $ \a \b \k \n \u1 \u2 \u3 \h
                    \f f $ \as \af \nk \ns \t1 \t2 \t3 \oh
                      \f f (Nat.add as a) (Nat.add af b) (Nat.add nk k) (Nat.add ns n) (Nat.add t1 u1) (Nat.add t2 u2) (Nat.succ (Nat.add t3 u3)) (Nat.add oh h))
                  (Nat.succ (Nat.add l1 l2))))
            z))

_extract = \cost_data Pair.match (\cost \_l
  cost (\f f 0 0 0 0 0 0 0 0) $ \as \af \nk \ns \t1 \t2 \t3 \oh
    [Nat.to_string oh; "|";
     Nat.to_string as; Nat.to_string af; Nat.to_string nk; Nat.to_string ns;
     Nat.to_string t1; Nat.to_string t2; Nat.to_string t3; "|";
     Nat.to_string (Nat.add as af);
     Nat.to_string (Nat.sum [nk; ns; t1; t2; t3])]) cost_data

_collect = fix $ \self \current List.match
    []
    (\next \rest
        triage _ _ (\_ \cost_data △ (_extract cost_data) (self (current next) rest))
        $ _eval current next
    )

_header = ["oh"; "|"; "0a"; "0b"; "1"; "2"; "3a"; "3b"; "3c"; "|"; "alc"; "red"]

_widths = List.foldr
    (\row \acc List.zip_with (\a \s Nat.max a (List.length s)) acc row)
    (List.repeat (List.length _header) 0)

_format_table = \rows
    let (△ _header rows) $ \all_rows
    let (_widths all_rows) $ \widths
    List.join [10]
      (List.map (\row List.join " " (List.zip_with (\w String.pad_left w ' ') widths row)) all_rows)

run = List.match "" $ \hd \tl
    let (_collect hd tl) $ \rows
    List.match "" (\_ \_ _format_table rows) rows

_exercise_all_rules = \tt △ (△ (△ (△ (△ tt △)))) △ (△ (△ △ △)) △
_exercise_all_rules_n = fix $ \self Nat.match (△ △) (\pred _exercise_all_rules $ self pred)
run [_exercise_all_rules; △ △]
# = oh | 0a 0b 1  2 3a 3b 3c | alc red
#    0 | 10  8 9 13  1  1  1 |  18  25
run [_exercise_all_rules_n; 0]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    1 |  6  8 11 12  1  0  1 |  14  25
run [_exercise_all_rules_n; 1]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    3 | 23 27 39 43  3  2  5 |  50  92
run [_exercise_all_rules_n; 10]
# = oh |  0a  0b   1   2 3a 3b 3c | alc red
#   37 | 198 272 359 398 23 20 55 | 470 855
run [_exercise_all_rules_n; 100]
# =  oh |   0a   0b    1    2  3a  3b  3c |  alc  red
#   395 | 1993 2866 3676 4074 205 200 591 | 4859 8746
