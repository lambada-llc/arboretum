# JSON text from a JSON value.
#
# A value is Null, Bool b, String s, Array a, Object entries or
# Number mantissa scale, Scott-encoded, so rendering one is the value applied
# to one handler per constructor, with [fix] threading the recursion. Strings
# are byte lists.
#
# [Number m s] is m × 10⁻ˢ, exactly: the mantissa's digits with a point s of
# them from the right. Every number the format admits is a finite decimal, and
# every finite decimal is some m × 10⁻ˢ, so this is as expressive as the
# grammar and no more — there is nothing to round, and no way to ask for the
# infinity or NaN that JSON has no syntax for. A rational would have been both
# lossy and too expressive: 1/3 is not a JSON number. A power of ten above
# zero is the mantissa's own trailing zeros ([Number 1500 0]), which is why
# the scale is a plain Nat and the output never needs an exponent.
#
# [Object] holds an association list rather than a map, which is what the
# format permits: entries keep the order they were built in, and a key may
# repeat. [quote] escapes only what the format requires — the quote, the
# backslash, and the C0 controls as \u00XX — so every other byte passes
# through and text that is already UTF-8 stays UTF-8 without this module
# knowing anything about encodings. [to_string] writes the compact form, with
# no space around , or :.

JSON \= Null | Bool b | String s | Array a | Object entries | Number mantissa scale

_escape_char = \c
  Bool.match
    (Bool.match
      (Bool.match
        [c]
        (List.concat "\\u00" (Nat.byte_to_hex c))
        (Nat.is_lte c 31))
      "\\\\"
      (equal_const 92 c))
    "\\\""
    (equal_const 34 c)

quote = \s List.concat_list ["\""; List.concat_map _escape_char s; "\""]

# Place the point s digits from the right of a mantissa's digits. Both sides of
# it must carry a digit — the grammar admits neither "1." nor ".5" — so a
# mantissa with no more digits than the scale gets the "0." and the zeros that
# separate the point from its digits.
_point = \digits \s
  let (List.length digits) $ \n
  Bool.match
    (List.concat_list [List.take (Nat.sub n s) digits; "."; List.drop (Nat.sub n s) digits])
    (List.concat_list ["0."; List.repeat (Nat.sub s n) '0'; digits])
    (Nat.is_lte n s)
# Nat.to_string gives the digits without a leading zero, which is the one thing
# the grammar rules out in front. Zero is written "0" at every scale: the
# mantissa is what the value is, and a scale cannot make it another number.
_number = \m \s
  Bool.match
    (let (Nat.to_string (Int.abs m)) $ \digits
     let (Bool.match (_point digits s) digits (Nat.is_zero s)) $ \body
     Bool.match body (List.concat "-" body) (Int.is_negative m))
    "0"
    (Nat.is_zero (Int.abs m))

to_string = fix $ \self \json json
  "null"
  (Bool.match "false" "true")
  quote
  (\a List.enclose "[" "," "]" self a)
  (\entries List.enclose "{" "," "}" (Pair.match $ \k \v List.concat_list [quote k; ":"; self v]) entries)
  _number

from_int = \i Number i 0
from_nat = \n Number (Int.from_nat n) 0

to_string Null
# = null
to_string $ Bool false
# = false
to_string $ Bool true
# = true
to_string $ String "hello"
# = "hello"
to_string $ String "a\tb"
# = "a\u0009b"
to_string $ Array []
# = []
to_string $ Array [Null; Bool true; String "x"]
# = [null,true,"x"]
to_string $ Object []
# = {}
to_string $ Object [△ "name" $ String "Alice"; △ "age" $ Null]
# = {"name":"Alice","age":null}
to_string $ Object [△ "items" $ Array [Bool true; Bool false]; △ "count" $ String "2"]
# = {"items":[true,false],"count":"2"}

to_string $ from_nat 0
# = 0
to_string $ from_nat 42
# = 42
to_string $ from_int (Int.negate (Int.from_nat 42))
# = -42
# A scale splits the same digits: 1234 at 2 is 12.34, at 4 it is 0.1234.
to_string $ Number (Int.from_nat 1234) 2
# = 12.34
to_string $ Number (Int.from_nat 1234) 4
# = 0.1234
# Fewer digits than the scale: the zeros between point and digits are written.
to_string $ Number (Int.from_nat 5) 3
# = 0.005
to_string $ Number (Int.negate (Int.from_nat 25)) 2
# = -0.25
# A power of ten above zero needs no exponent, just the trailing zeros.
to_string $ Number (Int.from_nat 1500) 0
# = 1500
# Zero is zero at any scale, and never "-0".
to_string $ Number (Int.from_nat 0) 5
# = 0
to_string $ Object [△ "n" $ from_nat 7; △ "xs" $ Array [from_nat 1; Number (Int.from_nat 15) 1]]
# = {"n":7,"xs":[1,1.5]}
