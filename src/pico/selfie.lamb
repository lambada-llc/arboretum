# The selfie's program as plain LambAda. The build compiles it to a tree, and
# its generator turns that tree into a smaller one that gives it back: the
# generated selfie, which is what the board runs — at the end of this file, as
# a show, with its picture and the image to flash.
#
#   triage a b c x         a if x is △, b y if x is △ y, c y z if x is △ y z
#   △ (△ a b) c x          the same, where a or b uses a variable bound around
#                          it: triage would compile to another tree there
#   Pair.create a b        a pair, △ a b; Pair.match f (Pair.create a b) is f a b
#   _                      a value nothing reads
#   (\x body) e            body with e for x
#
# selfie_program binds the helpers that are used everywhere once, and what
# uses them takes them as its first arguments, the one it uses most last:
# naming them instead would put a copy of each in every definition that does.
# The small ones are named all the same, as a copy costs less than passing it,
# but a definition that uses one twice binds it once (binc in _bin, ud in
# _nm).
# The generated selfie compiles this program on the board before it starts, and
# a variable costs more there the further out it is bound from where it is
# used; that is why the most used come last, why a definition whose inner code
# applies helpers to such arguments binds those applications at its top (turn
# and seg in _legs, say), and why _window and _tour bind some that only they
# use themselves (bsub, bin) or work them out where they are used (b2, tadd).
# The order selfie_program binds them in, and _window's and _tour's, are the
# ones that made the generated selfie smallest and quickest to start.
#
# Evaluation is eager: a part that uses none of a λ's variables is worked out
# before the λ is applied. A branch that would go on with the rest of the way
# is therefore given what it goes on with after it is chosen (nx in _turn, fin
# in _runs, an item's st and ta in _nl), not before, or the board would work
# out every branch's rest; and the sums of differences in _nm take where they
# start before the moves they make (j m2k inc dec), or every row would work out
# all of them.

# ── Basics ───────────────────────────────────────────────────────────────────
_p2 = \_ \g g
_z = \_ \_ \s s
# Numbers here are unary: 0 is △, Snat.succ x one more than x, and _less x
# one less than x. [iter x n f] is f applied n times to x, n a binary nat.
_less = △ △
_inc = triage Snat.one (\p Snat.succ (Snat.succ p)) _p2
_dec = triage (_less 0) id (\_ \m _less (_less m))
_iter = fix $ \r \x \bits triage const _ (\b \rest \x \f r (△ (△ id (\_ f)) _ b x) rest (\y f (f y))) bits x
# l's first n items.
_take = fix $ \r \l △ (△ [] (\n Pair.match (\b \rest List.cons b (r rest n)) l)) _
_last = fix $ \r \h △ (△ h _) r

# ── Layout ───────────────────────────────────────────────────────────────────
# A tree's outline is its rows below the root, each △ l r: how much further
# the leftmost pixel (l, mirrored) and the rightmost (r) reach than in the row
# above, as numbers that apply f or g that many times: [d f g s].
_church = fix $ \r △ (△ _z (\p \f \g \s f (r p f g s))) (\_ \m \f \g \s g (r m f g s))
# The need of two outlines side by side: the most by which the left one's right
# edge reaches past the right one's left edge, rows next to each other
# included. Walking down both, △ G n is the need so far and how far below it
# the current difference is; a row's moves count rises first.
_up = Pair.match $ \g \n △ (△ (Pair.create 0 (Snat.succ n)) (\g Pair.create g n)) _ g
_down = Pair.match $ \g \n Pair.create (Snat.succ g) n
# s after a row whose moves are ra, of the left one's right edge, and lb, of
# the right one's left edge; [ud x s] is s moved by x.
_step = \ud \ra \s \lb
  (\a \b △ (△ (\s a (b s)) (\_ \s b (a s))) _ (ra (\_ false) (\_ true) false) s) (ud lb) (ud ra)
# A fork's diagonals are k long, 2k at least the need plus 2, taken from ks,
# the list 1, 2, 3, … so that every fork with the same k shares it. ks goes
# to 256.
_half = fix $ \h △ (△ Pair.fst (\p \ks △ (△ (Pair.fst (Pair.snd ks)) (\q h q (Pair.snd ks))) _ p)) _
_ks_step = Pair.match $ \v \l Pair.create (triage _ id _ v) (List.cons v l)
_ks = \iter \church (\n Pair.snd (church n _ks_step _ (Pair.create n []))) (iter 0 256 Snat.succ)
# A fork's outline: k diagonal rows, then its children's rows merged — left of
# the left child, right of the right one — down to where the shorter one ends,
# where the longer one takes over: that row's step is the way from the shorter
# one's last row to it, m2k plus the differences summed on the way down.
# One walk down both children's outlines finds the need and merges them: △ k
# rows, the rows below the diagonals; [_nm_end s f] is that, s the need and f
# the rows given m2k.
_nm_end = \iter \dec \church \s \f (\k Pair.create k (f (church k dec _ (church k dec _ 0)))) (_half (Pair.snd s) (_ks iter church))
# [_jsum s f g j]: s moved by the moves in j, each △ x y: by x, and by y the
# other way.
_jsum = \s \f \g fix (\r triage s _ (\p \l Pair.match (\x \y x f g (y g f (r l))) p))
# Where the shorter outline ends, the longer one takes over its side: mk makes
# the next row of e, the longer one's move on that side, plus m2k and the moves
# in j; rest are the longer one's rows below it.
_nm_over = \ud \inc \dec \church \fin \e \j \rest \mk \s fin (ud e s) (\m2k List.cons (mk (church (e inc dec (_jsum m2k inc dec j)))) rest)
# Where both go on: the row la rb, and the walk w on below it.
_nm_next = \ud \w \jl \jr \ca \la \ra \hb \cb \s Pair.match (\lb \rb
    Pair.match (\k \rows Pair.create k (List.cons (Pair.create la rb) rows))
      (w (_step ud ra s lb) (List.cons (Pair.create lb la) jl) (List.cons (Pair.create ra rb) jr) ca cb))
  hb
# [w s jl jr ca cb]: s the need so far; jl and jr the moves so far on the left
# and right, the last first, each △ x y: x of the one that goes on there, y of
# the other's; ca and cb the rows left of each.
_nm = \iter \inc \dec \church (\ud
  (\fin (\over fix $ \w \s \jl \jr \ca \cb
    △ (△ (△ (△ (\s fin s (\_ [])) _) (\hb \cb \s Pair.match (\lb \rb over lb jl cb (\x Pair.create x rb) s) hb)) _)
      (\ha \ca \cb \s Pair.match (\la \ra
        △ (△ (\ra over ra jr ca (Pair.create la)) _) (\hb \cb \ra _nm_next ud w jl jr ca la ra hb cb) cb ra s)
        ha)
      ca cb s)
    (_nm_over ud inc dec church fin))
  (_nm_end iter dec church)) (\x x _up _down)
# A tree's forks, each △ (△ left right) k, and its outline.
_lay = \iter \inc \dec \church
  (\nm \diag fix $ \r △ (△ (Pair.create [] []) (\c Pair.match (\a \rows Pair.create a (List.cons (Pair.create _z _z) rows)) (r c)))
    (\a \b Pair.match (\aa \ca Pair.match (\ab \cb
      Pair.match (\k \rows Pair.create (Pair.create (Pair.create aa ab) k) (diag k rows)) (nm (Pair.create 0 0) [] [] ca cb))
      (r b)) (r a)))
  (_nm iter inc dec church) (\k church k (List.cons (Pair.create const const)) _)

# ── Columns ──────────────────────────────────────────────────────────────────
# Across the whole tree, a column is △ h (△ u o): o columns into the 32-column
# tile h, u = 31 − o, so that a step either way is a step of each. n31, 31,
# is dec b1.
_n25 = \iter iter 0 25 Snat.succ
_b1 = \iter iter 0 32 Snat.succ
_b2 = \b1 \church church b1 Snat.succ _ b1
_cinc = \n31 \inc Pair.match $ \h Pair.match $ \u \o △ (△ (\h Pair.create (inc h) (Pair.create n31 0)) (\u \h Pair.create h (Pair.create u (Snat.succ o)))) _ u h
_cdec = \n31 \dec Pair.match $ \h Pair.match $ \u △ (△ (Pair.create (dec h) (Pair.create 0 n31)) (\o Pair.create h (Pair.create (Snat.succ u) o))) _
_x0 = \n31 Pair.create 0 (Pair.create n31 0)
# A column with u and o parts of n31, so that columns kept share them.
_nz = \n31 \dec \church Pair.match $ \h Pair.match $ \u \o Pair.create h (Pair.create (church o dec _ n31) (church u dec _ n31))
# x if column a is not right of column b, else y.
_le = \inc \dec \church (\diff \a \b \x \y Pair.match (\ha \uoa Pair.match (\hb
    △ (△ (\uob △ (△ x (\_ y)) (\_ \_ x) (diff (Pair.snd uob) (Pair.snd uoa))) (\_ \_ y)) (\_ \_ \_ x)
      (diff hb ha))
  b) a) (\m \n church m dec inc n)

# ── Drawing ──────────────────────────────────────────────────────────────────
# A row of pixels is a list of items, left to right, each △ x (△ r (△ st (△ t a))):
# a pixel at column x, the edge toward subtree t r pixels long yet (unseen if
# negative), st Pair.fst or Pair.snd as it steps left or right, a t's forks. fs
# is the step left and the step right, △ cdec cinc or △ dec inc. [nl fs lv] is the
# row below lv: each item a step further, and one whose edge reaches node t
# what _arrive makes of it. There a leaf ends it, and a stem's child goes on
# right below it; a fork's children go on from the columns next to it, k long.
_split = \fs \x \acc \a \tl \tr Pair.match (\lr \k Pair.match (\al \ar
    △ (△ _ (\k (\child child Pair.fst tl al (child Pair.snd tr ar acc)) (\st \t \a List.cons (Pair.create (st fs x) (Pair.create k (Pair.create st (Pair.create t a)))))))
      _ k)
  lr) a
_arrive = \fs \x \st \ta \acc Pair.match (\t \a
    △ (△ acc (\t List.cons (Pair.create x (Pair.create 0 (Pair.create st (Pair.create t a)))) acc)) (_split fs x acc a) t)
  ta
_nl = \fs fix $ \r Pair.match (\it \rest
  (\acc Pair.match (\x Pair.match (\n (\move
      △ (△ (Pair.match (\st \ta _arrive fs x st ta acc)) move) (\_ move) n)
    (\m \sa List.cons (Pair.create (Pair.fst sa fs x) (Pair.create m sa)) acc))) it)
  (r rest))
# An item's colour in a row q, const in an even row and _p2 in an odd one. An edge
# is on a diagonal, a row a pixel, and its two greys take turns along it, so
# that it shows which way it moves.
_flip = \q q _p2 const
_grey = \v [v; v; v]
_colour = \q Pair.match $ \_ Pair.match $ \r Pair.match $ \_ Pair.match $ \t \_
  △ (△ ((\c △ (△ c (\_ List.cons 0 c)) (\_ \_ List.cons 0 (List.cons 0 c)) t) [255]) (\_ (\g q (g 112) (g 56)) _grey)) (\_ \_ []) r
# l with c at position p.
_set = fix $ \r △ (△ (\l \c Pair.match (\_ List.cons c) l) (\p \l \c Pair.match (\h \tl List.cons h (r p tl c)) l)) (\_ \_ const)
_blank = \b1 \n25 \church church (church b1 Snat.succ _ n25) (List.cons []) _ []
# The window's 25 rows, from row lv down, each a list of colours from column uo.
_rows = \nl \b1 \n25 \foldr \inc \dec \church \uo (\from \blank \next fix $ \r \n \lv \q
  △ (△ [] (\n
      List.cons (from (foldr (\it \d _set (Pair.fst it) d (_colour q it)) blank lv))
        (r n (next lv) (_flip q))))
    _ n) (church (Pair.snd uo) Pair.snd Pair.snd) (_blank b1 n25 church) (nl (Pair.create dec inc))
# k of the columns from tile's first to tile h's, if h is from two tiles before
# tile to three after it; acc if not.
_near_tile = \b2 \b1 \inc \dec \church \tile \acc \h
  △ (△ (\k k 0) (△ (△ (\k k b1) (△ (△ (\k k b2) (△ (△ (\k k (church b1 Snat.succ _ b2)) (\_ \_ acc)) _)) _)) _))
    (\_l △ (△ (\k k (church b1 dec dec 0)) _) (\_l △ (△ (\k k (church b2 dec dec 0)) _) (\_ \_ \_ acc)))
    (church tile dec inc h)
# The items of lv near tile, columns counted from its first: those in the
# tiles from two before it to three after, all that can reach the window
# within 49 rows.
_near = \foldr \inc \church \nt \lv \tile foldr (\it \acc Pair.match (\x \e Pair.match (\h \o
    nt tile acc h (\b List.cons (Pair.create (church o inc inc b) e) acc))
  x) it) [] (Pair.fst lv)

# ── Numbers in bits ──────────────────────────────────────────────────────────
# Least significant first: n + 1; a − b − c as Option.some (its bits), or
# Option.none if that is below 0, c a bit; 32 t + o frames, from △ t o; such
# counts added; t mod n.
_binc = fix $ \r triage [true] _ (△ (△ (List.cons true) (\_ \rest List.cons false (r rest))) _)
_bit = triage (Pair.create false false) (\_ Pair.create true false) (\_l triage (Pair.create true true) _ (\_ \_ Pair.create false true))
_bsub = \inc \dec \church (\diff fix $ \s \c \a \b
  (\step (\na △ (△ (\b △ (△ (\_l triage (Option.some []) (\_ Option.none) _ c) _) na b b) _) na a b) (\_ \_ step a))
  (\a \b Pair.match (\d \c △ (△ Option.none (\x Option.some (List.cons d x))) _ (s c (Pair.snd a) (Pair.snd b)))
    (_bit (diff (Pair.fst b) (diff c (Pair.fst a)))))) (\m \n church m dec inc n)
_bin = \iter \church Pair.match $ \t \o (\binc church o binc _ (church (iter 0 5 Snat.succ) (List.cons false) _ (church t binc _ 0))) _binc
# a − b; u − n as Option.some (u − n), or Option.none if n is larger.
_sub = fix $ \d \n \u △ (△ (Option.some u) (\n △ (△ Option.none (d n)) _ u)) _ n
_tadd = \b1 \church \a \b Pair.match (\t \o Pair.match (\t2 \o2
    (\t3 \o △ (△ (Pair.create t3) (\x \_o Pair.create (Snat.succ t3) x)) _ (_sub b1 o) o) (church t Snat.succ _ t2) (church o Snat.succ _ o2))
  b) a
_bmod = \bsub \foldr \n \t foldr (\b \k (\k △ (△ k id) _ (bsub false k n)) (List.cons b k)) 0 t
# The item of l, each △ n x, n frames in bits, that frame t falls in, and t
# frames into it: △ x t.
_find = \bsub fix $ \f \l \t Pair.match (\h \rest Pair.match (\n \x △ (△ (Pair.create x) (\d \_ f rest d)) _ (bsub false t n) t) h) l
# The window's place t frames into a segment.
_place = Pair.match $ \kpl \t Pair.match (\k \pl Pair.create (Pair.snd pl) (k t (Pair.fst pl))) kpl

# ── The tour ─────────────────────────────────────────────────────────────────
# The rows from lv down, 25 to a band, each band △ lv s: its top row, as _ho
# makes it, and its runs left to right, each △ a z: from where the window shows
# nothing before columns with pixels, no 25 of them empty in a row, to where it
# shows nothing after them. What grows from a pixel of lv in the 24 rows below
# it keeps to columns next to each other.
# Runs s with a z among them: runs that overlap or meet made one.
_ins = \le fix $ \i \s \a \z △ (△ [Pair.create a z] _) (\az \s Pair.match (\a2 \z2
    le a2 z (\s (\a le z z2 (List.cons (Pair.create a z2)) (\s i s a z) s) (le a a2 a a2)) (\s List.cons (Pair.create a z) (List.cons az s)) s)
  az) s
# The larger of a and b.
_max = \inc \dec \church \a \b △ (△ a (\_ b)) (\_ \_ a) (church a dec inc b)
# How far, △ l h, left and right, what grows from a pixel reaches in the d rows
# below it, m rows above node t, stepping st, a t's forks, a pixel at a time:
# _reach; the same one row further on, stepping st: _s1.
_s1 = \st Pair.match (st (Pair.create (\l \h Pair.create (Snat.succ l) (triage 0 id _ h)) (\l \h Pair.create (triage 0 id _ l) (Snat.succ h))))
# What grows from a fork's children, k rows below it: the further of the two
# on each side.
_reach_fork = \max \g \a \d \tl \tr Pair.match (\lr \k Pair.match (\al \ar
    (\gk Pair.match (\l \h Pair.match (\l2 \h2 Pair.create (max l2 l) (max h h2)) (gk Pair.snd tr ar)) (gk Pair.fst tl al)) (g d k))
  lr) a
# [_reach_at max g a t d]: at node t, d rows left, nothing if d is 0 or t a
# leaf, else what grows from its children: a stem's right below it, walked on
# from there, and a fork's from where its diagonals end, by g.
_reach_at = \max \g \a fix $ \n \t \d
  △ (△ (Pair.create 0 0) (\d2 △ (△ (Pair.create 0 0) (\t n t d2)) (_reach_fork max g a d) t)) _ d
_reach = \inc \dec \church (\max fix $ \g \d \m \st \t \a (\n fix (\w \d \m
    △ (△ (n t) (\m △ (△ (Pair.create 0 0) (\d _s1 st (w d m))) _)) _ m d) d m) (_reach_at max g a))
  (_max inc dec church)
# A row with each column △ tile o, o a part of n31, so that the rows kept
# share it.
_ho = \n31 \foldr \dec \church \row foldr (\it List.cons (Pair.match (\x Pair.create (Pair.match (\c \uo Pair.create c (church (Pair.fst uo) dec _ n31)) x)) it)) [] row
# Runs s with one for item it among them.
_run = \cdec \cinc \le \n25 \iter \inc \dec \church (\ins \reach \back \it \s Pair.match (\x Pair.match (\m Pair.match (\st Pair.match (\t \a Pair.match (\l \h
    ins s (church l cdec _ (back x)) (church (Snat.succ h) cinc _ x))
  (reach m st t a))))) it) (_ins le) (_reach inc dec church (dec n25)) (\x iter (Pair.match (\h Pair.create (dec h)) x) 7 cinc)
_band = \nz \cdec \cinc \le \n31 \n25 \foldr \iter \inc \dec \church \row
  Pair.create (_ho n31 foldr dec church row)
    (foldr (\pq List.cons (Pair.match (\a \z Pair.create (nz a) (nz z)) pq)) []
      (foldr (_run cdec cinc le n25 iter inc dec church) [] row))
# The bands are made last first and reversed, so that what makes a band is
# let go before the next one is made.
_bands = \nz \cdec \cinc \nl \le \n31 \n25 \foldr \iter \inc \dec \church (\down \band fix $ \r triage List.reverse _ (\h \t \acc (\l
  r (down l) (List.cons (band l) acc)) (List.cons h t)))
  (fix (\b △ (△ id (\n \lv b n (nl (Pair.create cdec cinc) lv))) _) n25) (_band nz cdec cinc le n31 n25 foldr iter inc dec church)
# The window's way: segments △ r (△ kind (△ pos (△ lv d))), r frames from pos
# on as △ t o, 32 t + o of them (made when needed, as \_ r), kind m pos the
# window's place m frames on, m in bits, △ x skip: its left column x, its top
# skip rows below lv's, which d, the way its band goes, says is an even row or
# an odd one. Across each band in turn, alternately rightward and leftward —
# the way d, const or _p2 — over each run: from where the window shows nothing to
# where it shows nothing again; but at the band's far side, if the next band's
# run there ends no 24 columns short of this one, to where the window shows the
# further of the two at its edge, and down there.
_rv = (\f fix (\v \acc △ (△ acc _) (\x v (List.cons (f x) acc))) []) Pair.swap
# The segments g over runs cl, each △ from to, from s: each to its to, and on
# from the next one's from; the last one fin c s.
_runs = fix $ \u \cl \g \s \fin Pair.match (\c \more △ (△ (\fin fin c) _) (\c2 \m \fin \s List.cons (g s (Pair.snd c)) (u (List.cons c2 m) g (Pair.fst c2) fin)) more fin s) cl
# The frames from column s to e going the way d, △ t o: 32 t + o of them.
_span = \inc \dec \church \d \s \e Pair.match (\hl \uol Pair.match (\hh \uoh
    (\t △ (△ (Pair.create (dec t) (church (Pair.snd uoh) Snat.succ _ (Snat.succ (Snat.succ (Pair.fst uol))))) (\x Pair.create t (Snat.succ x))) _ (_sub (Pair.snd uol) (Pair.snd uoh)))
    (church hl dec inc hh))
  (d e s)) (d s e)
_across = \iter \st \ti \m Pair.match $ \c Pair.create (iter (iter c (iter m 5 Pair.snd) (Pair.match (\h Pair.create (ti h)))) (_take m (iter 0 5 Snat.succ)) st)
_sink = \iter \m Pair.match $ \c \s Pair.create c (iter s m Snat.succ)
_k24 = \n25 \dec \_ Pair.create 0 (dec n25)
_seg = \cdec \cinc \iter \inc \dec \church (\span \across \d \lv \s \e
  Pair.create (\_ span d s e) (Pair.create (across (d cinc cdec) (d inc dec)) (Pair.create (Pair.create s 0) lv))) (_span inc dec church) (_across iter)
# x if column a is not behind column b going the way d, else y.
_led = \le \d \a \b d (le a b) (le b a)
# The segment down to the next band, from column x: 24 frames.
_drop = \n25 \iter \dec \lv \x Pair.create (_k24 n25 dec) (Pair.create (_sink iter) (Pair.create (Pair.create x Snat.one) lv))
# At a band's far side, going the way d with segments g: from e, where its last
# run ends, on to where the next band's first run starts, n; nx x the rest from
# column x there.
_turn = \nz \cdec \cinc \le \n25 \iter \dec \church (\led \c24 \c25 \drop \d \lv \g \e \n \nx
  (\bk
    (\x led d (c24 bk _ e) n
        (\nx \s List.cons (g s x) (List.cons (drop lv x) (nx x)))
        (\nx \s List.cons (g s e) (nx n)) nx)
    (nz (c25 bk _ (led d e n n e))))
  (d cdec cinc)) (_led le) (church (dec n25)) (church n25) (_drop n25 iter dec)
# Where the way over band b starts, going against d: its last run's end if
# d goes rightward, its first run's start if not.
_entry = \d \b Pair.match (\_ \s d (Pair.snd (Pair.match _last s)) (Pair.fst (Pair.fst s))) b
_legs = \nz \cdec \cinc \le \n25 \iter \inc \dec \church (\turn \seg fix $ \r \bands \d \x Pair.match (\b \rest Pair.match (\lv \s
    (\lv
      (\g _runs (d id _rv s) g x (\c
          △ (△ (\s [g s (Pair.snd c)]) _)
            (\b \r2 turn d lv g (Pair.snd c)
              (_entry d b)
              (r (List.cons b r2) (d _p2 const)))
            rest))
      (seg d lv))
    (Pair.create lv d))
  b) bands) (_turn nz cdec cinc le n25 iter dec church) (_seg cdec cinc iter inc dec church)
# The segments in eights, each △ n (its segments △ n (△ kind (△ pos lv))), n
# their frames in bits, and the frames in all, △ t o; each eight made by a
# function of its own, so that what makes it is let go before the next one.
_force = \sg List.cons (Pair.create (Pair.fst sg _) (Pair.snd sg))
_grp = \tadd \bin \foldr \c
  (\r Pair.create r (Pair.create (bin r) (foldr (\sg List.cons (Pair.create (bin (Pair.fst sg)) (Pair.snd sg))) [] c)))
  (foldr (\sg tadd (Pair.fst sg)) (Pair.create 0 0) c)
_gk = \tadd \g \x \l Pair.match (\gs \r Pair.create (List.cons (Pair.snd x) gs) (tadd (Pair.fst x) r)) (g l)
_groups = \tadd \bin \foldr \iter (\n8 fix $ \g triage (Pair.create [] (Pair.create 0 0)) _ (\h \t
  _gk tadd g (_grp tadd bin foldr (foldr _force [] (_take (List.cons h t) n8)))
    (fix (\r \n \l △ (△ l (\p r p (Pair.snd l))) _ n) n8 (List.cons h t)))) (iter 0 8 Snat.succ)
# The first row: the root's pixel, toward self laid out.
_top = \self \n31 \iter \inc \dec \church [Pair.create (_x0 n31) (Pair.create 0 (Pair.create Pair.fst (Pair.create self (Pair.fst (_lay iter inc dec church self)))))]
# [_tour self]: self laid out and the window's way over it, as groups of
# segments in bits, and its frames.
_tour = \self \nz \b1 \cdec \cinc \nl \le \n31 \n25 \foldr \iter \inc \dec \church (\bin
  ((\groups \legs \bands Pair.match (\gs \r Pair.create gs (bin r))
    (groups (legs bands const (Pair.fst (Pair.fst (Pair.snd (Pair.fst bands)))))))
   (_groups (_tadd b1 church) bin foldr iter) (_legs nz cdec cinc le n25 iter inc dec church))
  (_bands nz cdec cinc nl le n31 n25 foldr iter inc dec church
    (_top self n31 iter inc dec church) [])) (_bin iter church)

# ── The program ──────────────────────────────────────────────────────────────
# The colour at column x of row y.
_pixel = \iter \rows \y (\at at (at rows y)) (\l \n Pair.fst (iter l n Pair.snd))
# [_window gs n t]: t frames on, the window, t mod the way's frames n, found
# eight segments at a time.
_window = \nl \iter \b1 \n25 \foldr \inc \dec \church (\bsub (\find \pixel \rows \next \near \bmod \gs \n \t
  Pair.match (\lv Pair.match (\col \skip Pair.match (\tile \uo
      pixel
      (rows uo n25 (church skip next next (near lv tile)) (church skip _flip _flip (Pair.snd lv))))
    col))
  (Pair.match (\segs \t _place (find segs t)) (find gs (bmod n t))))
  (_find bsub) (_pixel iter) (_rows nl b1 n25 foldr inc dec church) (nl (Pair.create dec inc))
  (_near foldr inc church (_near_tile (_b2 b1 church) b1 inc dec church)) (_bmod bsub foldr))
  (_bsub inc dec church)
# [selfie_program self i]: the stage, the tour; then the window.
selfie_program = \self
  (\church (\nl (\inc (\dec (\le (\iter (\b1 (\n31 (\cdec (\cinc (\n25 (\foldr (\nz
    \_ Pair.match (_window nl iter b1 n25 foldr inc dec church)
      (_tour self nz b1 cdec cinc nl le n31 n25 foldr iter inc dec church))
  (_nz n31 dec church)) List.foldr) (_n25 iter)) (_cinc n31 inc)) (_cdec n31 dec)) (dec b1))
  (_b1 iter)) _iter) (_le inc dec church)) _dec) _inc) _nl) _church

# ── The generated selfie ─────────────────────────────────────────────────────
# The generator packs the tree selfie_program compiles to, from that tree and
# nothing else, into a much smaller one that gives it back, given fix;
# expanded, that acts as selfie_program, applied to anything. So fix makes a
# selfie of it as it does of selfie_program.
_packed = Generator.compress selfie_program
selfie_gen = Generator.expand _packed
_selfie_gen = fix selfie_gen
# The show: on the board, slewing by 128 since the view moves with it, at 9.8
# frames a second, what the board manages.
_fps = 98
selfie_show = Pico.Matrix.show_staged 128 _fps _selfie_gen
# The program; packed, and expanded; the selfie.
_to_string = \l List.join " " $ List.map Nat.to_string l
[size selfie_program; size _packed; size selfie_gen; size _selfie_gen]
# = 50835 9336 9405 9442

# What it draws, 6.1 s of it:
Pico.Matrix.svg "selfie.svg" 60 selfie_show
# = selfie.svg image/svg+xml 187394 bytes sha256:3bf8119e3752000ecbbaf2e9c55c28b842b702969f80ba48c951265d43da0dcc
# The image to flash:
Pico.Matrix.flash "selfie.uf2" [selfie_show]
# = selfie.uf2 application/octet-stream 39936 bytes sha256:744169a0a030015deddd7b27cb4cf4f5dde6ceb4593379bf8e24681a1ed7d9ad
