# Selfie: a show that draws its own tree, a pixel a node, and slides the board's
# 25 × 25 window over it. render draws whatever tree it is given, fix hands it
# itself, and Generator.shrink makes it small: the tree drawn is the one running.

# Lays tree out and plans the window's way, then draws each frame. The helpers
# are bound once here and passed down; naming them in each part would copy them.
render = \tree
  (\church (\nl (\inc (\dec (\le (\iter (\b1 (\n31 (\cdec (\cinc (\n25 (\foldr (\nz
    \_ Pair.match (Pico.Matrix.Selfie.window nl iter b1 n25 foldr inc dec church)
      (Pico.Matrix.Selfie.tour tree nz b1 cdec cinc nl le n31 n25 foldr iter inc dec church))
    (Pico.Matrix.Selfie.nz n31 dec church))
    List.foldr)
    (Pico.Matrix.Selfie.n25 iter))
    (Pico.Matrix.Selfie.cinc n31 inc))
    (Pico.Matrix.Selfie.cdec n31 dec))
    (dec b1))
    (Pico.Matrix.Selfie.b1 iter))
    Pico.Matrix.Selfie.iter)
    (Pico.Matrix.Selfie.le inc dec church))
    Pico.Matrix.Selfie.dec)
    Pico.Matrix.Selfie.inc)
    Pico.Matrix.Selfie.nl)
  Pico.Matrix.Selfie.church

small_render = Generator.shrink render
selfie = fix small_render
_to_string = \l List.join " " $ List.map Nat.to_string l
[size render; size (fix render); size small_render; size selfie]
# = 50835 50872 9405 9442
Pico.Matrix.Selfie.to_preview_svg selfie
