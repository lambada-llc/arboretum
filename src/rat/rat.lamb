# Rational numbers as an `Int` numerator over a positive `Nat` denominator:
# `△ num den`.
#
# The sign lives in the numerator alone, so the denominator stays a plain `Nat`
# and every division below — `_gcd`, `_reduce`, `to_decimal` — is `Nat`
# arithmetic with no sign cases; `negate` flips the numerator's sign flag and
# `inv` keeps it there while the two magnitudes swap. That the denominator is
# positive is the caller's to maintain: `create` stores what it is given, and
# `inv zero` leaves a zero behind.
#
# Values are not canonical — `2/4` and `1/2` are distinct trees denoting the
# same number. `add`, `sub`, `mul` and `div` reduce their results, everything
# else preserves what it was handed, and `reduce` normalizes on demand.

_gcd = fix $ \self \a \b Bool.match (\b self b (Nat.mod a b)) (\b a) (Nat.is_zero b) b

create = Pair.create
numer = Pair.fst
denom = Pair.snd
from_int = \i Pair.create i 1
from_nat = \n from_int (Int.from_nat n)
zero = from_nat 0
one = from_nat 1

_reduce = \r Pair.match (\num \den (\g Pair.create (Int.create (Int.is_negative num) (Nat.div (Int.abs num) g)) (Nat.div den g)) (_gcd (Int.abs num) den)) r
reduce = _reduce

add = Pair.match $ \p \q Pair.match $ \r \s
  _reduce $ Pair.create (Int.add (Int.mul p (Int.from_nat s)) (Int.mul r (Int.from_nat q))) (Nat.mul q s)
negate = Pair.match $ \p \q Pair.create (Int.negate p) q
sub = \a \b add a (negate b)
mul = Pair.match $ \p \q Pair.match $ \r \s
  _reduce $ Pair.create (Int.mul p r) (Nat.mul q s)
inv = Pair.match $ \p \q Pair.create (Int.create (Int.is_negative p) q) (Int.abs p)
div = \a \b mul a (inv b)

_digits = fix $ \self \prec \rem \den
  Nat.match "" (\prec10
    Pair.match (\d \r △ (Nat.add '0' d) (self prec10 r den))
    $ Nat.divmod (Nat.mul_const 10 rem) den
  ) prec

# Fixed point: exactly `prec` digits after the point, truncated, not rounded.
to_decimal = \prec Pair.match $ \num \den
  Pair.match (\q \r
    let (List.concat (Nat.to_string q) $ △ '.' $ _digits prec r den) $ \body
    Bool.match body (List.concat "-" body) (Int.is_negative num)
  ) $ Nat.divmod (Int.abs num) den

to_string = Pair.match $ \num \den List.concat (Int.to_string num) $ △ '/' $ Nat.to_string den

_to_string = to_string
create (Int.from_nat 1) 3
# = 1/3
reduce $ create (Int.from_nat 2) 4
# = 1/2
add (from_nat 1) (from_nat 2)
# = 3/1
add (create (Int.from_nat 1) 3) (create (Int.from_nat 1) 6)
# = 1/2
sub (from_nat 1) (create (Int.from_nat 1) 3)
# = 2/3
sub (from_nat 1) (from_nat 2)
# = -1/1
mul (from_nat 2) (create (Int.from_nat 1) 3)
# = 2/3
div (from_nat 1) (from_nat 3)
# = 1/3
negate $ div (from_nat 1) (from_nat 4)
# = -1/4

_to_string = String.to_source
to_decimal 5 (from_nat 0)
# = "0.00000"
to_decimal 5 (from_nat 1)
# = "1.00000"
to_decimal 5 (div (from_nat 1) (from_nat 3))
# = "0.33333"
to_decimal 5 (div (from_nat 22) (from_nat 7))
# = "3.14285"
to_decimal 5 (negate $ div (from_nat 1) (from_nat 4))
# = "-0.25000"
