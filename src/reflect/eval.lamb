
# :: finalize:(T -> A -> R)
# -> rule0a:A
# -> rule0b:A
# -> rule1:A
# -> rule2:(A -> A -> A -> A)
# -> rule3a:A
# -> rule3b:(A -> A)
# -> rule3c:(A -> A -> A)
# -> (T -> T -> R)
evaluator = \finalize \rule0a \rule0b \rule1 \rule2 \rule3a \rule3b \rule3c
  \a \b triage _ _ finalize $ (fix $ \self
    triage
      (\z △ (△ z) rule0a)
      (\y \z △ (△ y z) rule0b)
      (triage
        (\y \z △ y rule1)
        (\x \y \z
          Pair.let (self x z) $ \r1 \a1
          Pair.let (self y z) $ \r2 \a2
          Pair.let (self r1 r2) $ \r \a
          △ r (rule2 a1 a2 a)
        )
        (\w \x \y \z
          triage
            (△ w rule3a)
            (\a
                Pair.let (self x a) $ \r \a
                △ r (rule3b a))
            (\a \b
                Pair.let (self y a) $ \r \a1
                Pair.let (self r b) $ \r \a2
                △ r (rule3c a1 a2))
            z))) a b

_compose3 = \f \g \h compose f (compose g h)
_compose4 = \f \g \h \i compose (compose f g) (compose h i)
count_eval_steps = evaluator (\_ \cost cost 0) id id Nat.succ (_compose4 Nat.succ) Nat.succ (compose Nat.succ) (_compose3 Nat.succ)
count_allocs = evaluator (\_ \cost cost 0) Nat.succ Nat.succ id _compose3 id id compose
count_eval_steps_if_parallel = evaluator (\_ \cost cost) 0 0 1 (\cost1 \cost2 \cost Nat.add (Nat.max cost1 cost2) (Nat.succ cost)) 1 Nat.succ (\cost1 \cost2 Nat.succ (Nat.add cost1 cost2))
max_parallel_steps = evaluator (\_ \cost cost) 1 1 1 (\cost1 \cost2 \cost Nat.max cost (Nat.add cost1 cost2)) 1 id Nat.max
eval_with_cost = evaluator Pair.create 0 0 1 (\c1 \c2 \c Nat.succ $ Nat.add c $ Nat.add c1 c2) 1 Nat.succ (\c1 \c2 Nat.succ $ Nat.add c1 c2)

eval = fix $ \self
    triage
      (\z △ z)
      (\y \z △ y z)
      (triage
        (\y \z y)
        (\x \y \z self (self x z) (self y z))
        (\w \x \y \z
          triage
            w
            (\a self x a)
            (\a \b self (self y a) b)
            z))

# [eval] reduces by recursing on the host: it normalizes both halves of an
# application before combining them, so a program the eager evaluators hang on
# hangs here too. [lazy_eval] reduces in normal order instead, and so returns on
# every program that has a normal form at all — while itself terminating
# eagerly, which is what lets this repository keep its rule and still run those.
#
# What buys that is the representation. Every term is △ applied to a list of
# arguments, so here a term *is* that list:
#     []            △
#     [a]           △ a
#     [a; b]        △ a b
#     [a; b; c; …]  a redex
# An unreduced application is just a longer list. Being data, it can be dropped
# or duplicated without the host ever looking inside it — which is the whole of
# the laziness: only [a], and for the fork rule [c], are ever forced.
_spine = fix $ \self triage [] (\a [self a]) (\a \b [self a; self b])
_unspine = fix $ \self List.match △ (\a \tl List.match (△ (self a)) (\b \_ △ (self a) (self b)) tl)

# [triage] for spines: dispatch one that is already in weak head normal form.
_triage_spine = \on_leaf \on_stem \on_fork
  List.match on_leaf (\p \tl List.match (on_stem p) (\q \_ on_fork p q) tl)

# Which argument gets forced, and when, is the whole point here, and on an eager
# host that is decided by *scope*: a subterm of a branch that mentions none of
# the branch's own variables is evaluated when the branch is built rather than
# when it is taken. So each forcing lives in a binding that takes what it forces
# as its last argument — [_redex] forces [a] only once there is a redex to
# dispatch, [_fork_rule] forces [c] only once the fork rule is the one running —
# and the partial applications that close over the rest force nothing.
_fork_rule = \self \b \rest \w \x \c _triage_spine
  (List.concat w rest)
  (\u List.concat x (△ u rest))
  (\u \v List.concat b (△ u (△ v rest)))
  (self c)

# The rule at the root, by the shape of [a] and, for a fork, of [c]:
#     △ △       b c  →  b
#     △ (△ x)   b c  →  (x c) (b c)
#     △ (△ w x) b c  →  w  |  x u  |  b u v   as c is  △ | △ u | △ u v
_redex = \self \b \rest \c \a _triage_spine
  (List.concat b rest)
  (\x List.concat x (△ c (△ (List.concat b [c]) rest)))
  (\w \x _fork_rule self b rest w x c)
  (self a)

# Weak head normal form: rewrite the root until fewer than three arguments are
# left, which is when there is no rule to apply and the spine is a tree again.
_whnf = fix $ \self \t
  List.match t (\a \t1
  List.match t (\b \t2
  List.match t (\c \rest self $ _redex self b rest c a) t2) t1) t

_nf = fix $ \self compose (List.map self) _whnf

# Normal form of [a b], for every [a] and [b] that have one.
lazy_eval = \a \b _unspine $ _nf $ List.concat (_spine a) [_spine b]

_to_string = Pair.to_source Nat.to_source Nat.to_source
eval_with_cost Nat.succ 0
# = (△ 1 1)
eval_with_cost Nat.succ 3
# = (△ 4 37)
eval_with_cost (Nat.add 1) 2
# = (△ 3 119)

_to_string = Nat.to_source
count_eval_steps Nat.succ 0
# = 1
count_eval_steps Nat.succ 3
# = 37
count_eval_steps (Nat.add 1) 2
# = 119

count_allocs Nat.succ 0
# = 0
count_allocs Nat.succ 3
# = 18

count_eval_steps_if_parallel Nat.succ 3
# = 25
max_parallel_steps Nat.succ 3
# = 6

_to_string = Bool.to_source
eval Bool.not false
# = true
eval Bool.not true
# = false
_to_string = Nat.to_source
eval (Nat.add 2) 3
# = 5

# lazy_eval agrees with eval wherever eval is defined at all
_to_string = Bool.to_source
lazy_eval Bool.not false
# = true
lazy_eval Bool.not true
# = false
_to_string = Nat.to_source
lazy_eval (Nat.add 2) 3
# = 5
