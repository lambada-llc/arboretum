# = 2
diff 3 5
# = 2
diff 3 3
# = 0
diff 0 7
# = 7
sum [1; 2; 3; 4]
# = 10
sum []
# = 0
sum [10; 20; 30]
# = 60
product [1; 2; 3; 4]
# = 24
product []
# = 1
product [5; 6]
