zero = △
_succ_body = \self \n List.match 1 (\hd \tl Bool.match (\_ △ true) (\self \tl △ false $ self self tl) hd self tl) n
succ__smallest = wait self_apply _succ_body
succ__fastest = self_apply _succ_body
succ = succ__fastest
_pred_body = \self \n List.match 0 (\hd \tl Bool.match (\self \tl △ true $ self self tl) (\_ List.match △ (\hd \tl △ false $ △ hd tl)) hd self tl) n
pred__smallest = wait self_apply _pred_body
pred__fastest = self_apply _pred_body
pred = pred__fastest
match = \zero_case \succ_case List.match
    zero_case
    (\hd \tl succ_case $ pred $ △ hd tl)
is_zero = List.match true (\_ \_ false)
add_3bits =
  Bool.match
    (Bool.match (\c △ c false) (\c △ (Bool.not c) c))
    (Bool.match (\c △ (Bool.not c) c) (\c △ c true))
_add_3bits_k =
  Bool.match
    (Bool.match
      (Bool.match (\k k false false) (\k k true false))
      (Bool.match (\k k true false) (\k k false true)))
    (Bool.match
      (Bool.match (\k k true false) (\k k false true))
      (Bool.match (\k k false true) (\k k true true)))
double = triage 0 _ (\h \t △ false (△ h t))
# Carry bit c into list l: l unchanged when there is no carry (O(1)), else succ l.
# Even the no-carry branch destructures l, so on symbolic input reduction stays
# stuck like List.zip; otherwise whole-program reduction of folds like from_string
# would diverge. Both branches are functions of l so neither (in particular succ)
# fires until selected.
_carry = \c Bool.match (\l List.match △ (\_ \_ l) l) succ c
# Pair the common low bits of a and b into a list of (ha,hb) forks, terminated by
# a stem △rem carrying the longer operand's remaining high tail (rem empty when
# they end together). Same head/tail-split shape as List.zip and the same
# per-step cost, but it stops at the shorter operand instead of padding to the
# longer — so add of unequal-length operands (add b 0, adds into a growing
# accumulator) costs O(min) rather than O(max).
_zip_rest = fix $ \self \l1 \l2
    (List.match (\l2 △)  (\h1 \t1 List.match △          (\h2 \t2 △ (△ h1 h2))) l1 l2)
    (List.match (\l2 l2) (\h1 \t1 List.match (△ h1 t1)  (\h2 \t2 self t1 t2))  l1 l2)
# Carry-fold over the paired bits, then ripple the final carry into the remainder
# carried by the terminal stem. succ is delayed (inside _carry) so it doesn't fire
# eagerly on every step. The recursion destructures its first argument so self
# never expands unconditionally.
_add = fix $ \self \lst \c triage
    (\k _carry k [])
    (\rem \k _carry k rem)
    (\pair \rest \k Pair.match (_add_3bits_k k) pair $ \s \c2 △ s (self rest c2))
    lst c
add = \a \b _add (_zip_rest a b) false
sub_3bits =
  Bool.match
    (Bool.match
        (Bool.match (△ true false) (△ false false))
        (Bool.match (△ false true) (△ true false)))
    (Bool.match
        (Bool.match (△ false true) (△ true false))
        (Bool.match (△ true true) (△ false true)))
_sub_3bits_k =
  Bool.match
    (Bool.match
      (Bool.match (\k k true false) (\k k false false))
      (Bool.match (\k k false true) (\k k true false)))
    (Bool.match
      (Bool.match (\k k false true) (\k k true false))
      (Bool.match (\k k true true) (\k k false true)))
_sub__smallest = fix $ \self List.match
    (\c 0)
    (\hd \tl \c Pair.match (\s \c △ s (self tl c)) (Pair.match (sub_3bits c) hd))
_sub__fastest = fix $ \self List.match
    (\c 0)
    (\hd \tl \c Pair.match (_sub_3bits_k c) hd $ \s \c2 △ s (self tl c2))
_sub_wc = fix $ \self List.match
    (\c Pair.create c 0)
    (\hd \tl \c Pair.match (_sub_3bits_k c) hd $ \s \c2
        Pair.match (\ok \result Pair.create ok (△ s result)) (self tl c2))
_canonicalize__common = \foldr foldr (\h \acc Bool.match 0 (△ h acc) (Bool.or (List.match false (\_ \_ true) acc) h)) 0
canonicalize__smallest = _canonicalize__common List.foldr__smallest
canonicalize__fastest = _canonicalize__common List.foldr__fastest
canonicalize = canonicalize__fastest
# ncsub: subtraction without the final canonicalize, so the result may carry
# trailing zero bits (assumes a >= b, like sub). Cheaper than sub; sub is just
# ncsub followed by canonicalize.
ncsub__smallest = \a \b _sub__smallest (List.zip a b) true
ncsub__fastest = \a \b _sub__fastest (List.zip a b) true
ncsub = ncsub__fastest
sub__smallest = \a \b canonicalize__smallest (ncsub__smallest a b)
sub__fastest = \a \b canonicalize__fastest (ncsub__fastest a b)
sub = sub__fastest
_sub_check__smallest = \a \b Pair.match (\ok \raw Bool.match △ (△ $ canonicalize__smallest raw) ok) $ _sub_wc (List.zip a b) true
mul = \a \b List.foldr (\h \s Bool.match id (add b) h (double s)) 0 a
# mul_const_naive k specializes multiplication to a constant multiplier k. It folds
# over the bits of k (most significant first) to *compose* a double-and-add function
# of the multiplicand: bit -> compose double; set bit -> add the multiplicand.
# Because the multiplicand is bound inside the composed pieces (not free in the
# fold) and composition flattens under reduction, this nearly reproduces the
# double/add chain one would write by hand — but two construction-time inefficiencies
# (a defensive top-bit seed and an uncontracted compose double id) leave it slightly
# larger than optimal. See mul_const for the version that fixes both.
mul_const_naive = \k List.match (\x 0)
    (\msb \rest List.foldl (\f \h Bool.match (compose double f) (\x add x (double (f x))) h) (\x Bool.match 0 x msb) rest)
    (List.reverse k)
# mul_const k: like mul_const_naive but emits the optimal double/add chain directly,
# with no post-hoc optimization — mul_const <literal> is byte-for-byte the chain one
# would write by hand. Two construction-time fixes over mul_const_naive: (1) seed the
# fold with id instead of guarding the (always-set) top bit — k = 0 still falls to
# the empty-bit-list case; (2) _smart_compose returns f when g is structurally id,
# contracting compose double id (the η-redex weak reduction leaves stuck) to double
# at compile time, using the now-cycle-free equal.
_smart_compose = \f \g Bool.match (compose f g) f (equal id g)
mul_const = \k List.match (\x 0)
    (\_ \rest List.foldl (\f \h Bool.match (_smart_compose double f) (\x add x (double (f x))) h) id rest)
    (List.reverse k)
# is_lte, two shapes:
# __smallest zips the operands and folds the pair list — smallest reduced
# tree because it reuses the shared zip/fold machinery.
is_lte__smallest = \a \b List.foldl__smallest
    (\acc Pair.match (\ha \hb Bool.match acc hb (Bool.xor ha hb)))
    true
    (List.zip a b)
# __fastest makes a single pass over both bit lists, LSB first, with no
# intermediate zip (~20% fewer reductions, but a larger tree). The most
# significant differing bit decides, so each step folds the current bit pair
# into the verdict so far. The verdict is a bool, so instead of threading it
# as data it selects one of two mutually recursive walks (_lte_t: a ≤ b so
# far, _lte_f: a > b so far); each bit pair either keeps or switches the
# walk. Once one operand is exhausted, any set bit remaining in the other
# side is more significant than everything seen and forces the outcome
# (_any). The walks tie the knot through _lte_body, which dispatches on the
# verdict and passes itself along (self_apply style). Per-step closures
# capture only self and single bits, so the reducer memoizes them.
_any = fix $ \self List.match false (\h \t Bool.match self (\t true) h t)
_lte_t = \self \a \b List.match
    (\b true)
    (\ha \ta \b List.match
        (\ta Bool.not (Bool.or ha (_any ta)))
        (\hb \tb \ta self self (Bool.or hb (Bool.not ha)) ta tb)
        b ta)
    a b
_lte_f = \self \a \b List.match
    _any
    (\ha \ta \b List.match
        (\ta false)
        (\hb \tb \ta self self (Bool.and hb (Bool.not ha)) ta tb)
        b ta)
    a b
_lte_body = \self \acc Bool.match _lte_f _lte_t acc self
is_lte__fastest = _lte_t _lte_body
is_lte = wait _lte_t _lte_body
_divmod = \succ \sub_check \foldr \a \b foldr
    (\h \acc
        Pair.match
            (\div \mod
                triage
                    (Pair.create (double div) mod)
                    (\new_mod Pair.create (succ (double div)) new_mod)
                    _
                    (sub_check mod h)
            )
            acc
    )
    (Pair.create 0 a)
divmod__smallest = \a \b _divmod succ__smallest _sub_check__smallest List.foldr__smallest a b
    ((fix $ \self List.match (\small 0) (\_ \big \small Pair.create small (self big (double small)))) a b)
divmod__fastest = \a \b
  Pair.match (\q \r Pair.create q (canonicalize r)) $
  List.foldr__fastest
    (\bit \acc Pair.match (\q \r
      Bool.match_ft
        (\b Pair.create (double q) (△ bit r))
        (\b Pair.create (succ__fastest (double q)) (sub__fastest (△ bit r) b))
        (is_lte__fastest b (△ bit r)) b)
    acc)
    (Pair.create 0 0)
    a
divmod = divmod__fastest
div__smallest = \a \b Pair.fst $ divmod__smallest a b
div__fastest = \a \b Pair.fst $ divmod__fastest a b
div = div__fastest
mod__smallest = \a \b Pair.snd $ divmod__smallest a b
mod__fastest = \a \b Pair.snd $ divmod__fastest a b
mod = mod__fastest
_to_digits = \base \digit fix $ \self List.match
    id
    (\hd \tl \acc Pair.match (\div \mod self div (△ (digit mod) acc)) (divmod (△ hd tl) base))
to_string_base = \base \digit \n Bool.match (_to_digits base digit n "") "0" (is_zero n)
from_string_base = \base \digit List.foldl (\acc \c add (mul_const base acc) (digit c)) 0
# Constant-operand adders and subtractors. Like [mul_const] for multiplication,
# these take an operand known at build time and reduce to an adder/subtractor
# specialized to that constant's bits: an unrolled chain with one step per
# constant bit — no zip, no 3-bit table, and no carry/borrow bookkeeping at
# runtime beyond what the constant's bits force.
#
# Each chain step matches one bit of the argument and hands the tail to the
# continuation for the carry/borrow state the step leaves behind. [_copy_step]
# owes nothing at its position and passes the bit through; [_flip_step] owes
# exactly one there (a set constant bit, or an incoming carry/borrow — owing
# both at once passes the bit through and keeps owing, which is [_copy_step]
# again on the other continuation). Once the constant's bits are exhausted, a
# pending carry is exactly [succ], a pending borrow exactly [pred], and no debt
# is [id]. [e] is the result when the argument runs out first: nothing for
# subtraction (which assumes k <= a), the remaining constant bits (plus the
# pending carry) for addition.
#
# Reductions per call roughly halve versus the general add/sub, but every owed
# position embeds both continuations, so the reduced tree grows with the
# constant's set-bit count — for a dense constant the shared general form can
# be smaller (see the size comparison in bench.lamb). The per-character parsing
# constants these serve are thin, and the block forms below shed the dense
# leading run entirely.
_copy_step = \e \k \l List.match e (\h \t △ h (k t)) l
_flip_step = \e \k0 \k1 \l List.match e (\h \t Bool.match (△ true (k0 t)) (△ false (k1 t)) h) l
_keep = _copy_step []
# Walk the constant's bits LSB-first, pairing the no-debt chain with the
# debt-pending one so a step can route each bit to either.
_sub_chain = fix $ \self List.match
    (Pair.create id pred)
    (\kb \rest Pair.let (self rest) $ \nb \b Bool.match
        (Pair.create (_keep nb) (_flip_step [] b nb))
        (Pair.create (_flip_step [] b nb) (_keep b))
        kb)
_add_chain = fix $ \self List.match
    (Pair.create id succ)
    (\kb \rest Pair.let (self rest) $ \nc \c
        let (△ kb rest) $ \low
        Bool.match
            (Pair.create (_copy_step low nc) (_flip_step (succ low) nc c))
            (Pair.create (_flip_step low nc c) (_copy_step (succ low) c))
            kb)
add_const = \k Pair.fst (_add_chain k)
# ncsub_const k assumes k <= a and may leave trailing zero bits where the
# constant's high bits cancel the argument's (like ncsub); sub_const
# canonicalizes, matching sub exactly.
ncsub_const = \k Pair.fst (_sub_chain k)
sub_const = \k compose canonicalize (ncsub_const k)
# The block forms additionally assume the argument has exactly the constant's
# bit-length (k <= a < 2^bitlen k) — true of an ASCII character and its
# power-of-two-aligned block base, the common case when parsing. Under that
# assumption the constant's leading run of set bits is guaranteed to match the
# argument's top bits and cancel, so those positions truncate away (the mask
# form: keeping the low bits) and only the constant's bits below the run —
# usually none — need a borrow chain.
_strip_high_run = List.foldr (\b \low Bool.match (△ b low) (List.match [] (\h \t △ b (△ h t)) low) b) []
_mask = fix $ \self List.match (\_ []) (\_ \rest _keep (self rest))
ncsub_const_block = \k
    let (_strip_high_run k) $ \low
    let (canonicalize low) $ \rem
    List.match (_mask low) (\_ \_ compose (ncsub_const rem) (_mask low)) rem
sub_const_block = \k compose canonicalize (ncsub_const_block k)
# The ASCII block bases shared by decimal/hex parsing; each assumes its
# argument is in the stated range.
# Note: the non-canonicalizing forms must not feed functions the build reduces to
# whole-program normal form against symbolic input (e.g. parser combinators), as
# that reduction diverges; use the sub_x_* forms there.
ncsub_x_48 = ncsub_const_block '0' # c - '0', c in '0'..'9'
ncsub_x_65 = ncsub_const_block 'A' # c - 'A', c in 'A'..'Z'/'A'..'F'
ncsub_x_97 = ncsub_const_block 'a' # c - 'a', c in 'a'..'z'/'a'..'f'
sub_x_48 = sub_const_block '0'
sub_x_65 = sub_const_block 'A'
sub_x_97 = sub_const_block 'a'
to_string = to_string_base 10 (add_const '0')
to_source = to_string
to_dstring = \n Bool.match (_to_digits 10 (add_const '0') n) (△ '0') (is_zero n)
# Decimal-string -> nat: subtract '0' from each digit directly. This is the small
# default. The from_string.lamb sibling defines a [__fastest] variant that
# memoizes the digit lookup into a table (larger tree, fewer reductions). Keeping
# the default here avoids a Memo dependency, so core Nat stays Memo-free.
from_string = from_string_base 10 sub_x_48
is_gte = \a \b is_lte b a
is_lt = \a \b Bool.not $ is_gte a b
is_gt = \a \b Bool.not $ is_lte a b
in_range = \lo \hi \x Bool.and (is_lte lo x) (is_lte x hi)
max = \a \b Bool.match a b $ is_lte a b
min = \a \b Bool.match b a $ is_lte a b
diff = \a \b Bool.match sub (\a \b sub b a) (is_lte a b) a b
sum = List.foldl add 0
product = List.foldl mul 1
pow = \base \exp Fn.pow_fast exp mul 1 base
max_list = List.foldl max 0
div2 = List.match 0 (\_ \tl tl)
factorial = fix $ \self \n match 1 (\pred mul n $ self pred) n

_to_string = to_source
add 0 0
# = 0
add 0 1
# = 1
add 1 0
# = 1
add 1 2
# = 3
add 5 3
# = 8
add 10 20
# = 30
