max_list [42]
# = 42
max_list []
# = 0
factorial 0
# = 1
factorial 1
# = 1
factorial 5
# = 120
factorial 10
# = 3628800

pred__smallest 1
# = 0
pred__smallest 2
# = 1
pred__smallest 3
