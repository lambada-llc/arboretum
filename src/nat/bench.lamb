# Base conversions: rendering a nat to a digit string (one divmod per output
# digit) and parsing it back (folding add∘mul over the input), in decimal, hex
# and binary.
_to_string = Nat.to_source
size Nat.to_string
# = 4718
size Nat.from_string
# = 2810
size Nat.from_string__fastest
# = 14871
size Nat.to_hex
# = 4735
size Nat.from_hex
# = 11925
size Nat.byte_to_hex
# = 8184
size Nat.to_bin
# = 1745
size Nat.from_bin
# = 2000

_to_string = id
