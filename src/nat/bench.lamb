# How close is `mul 10` to a function hand-specialized to x10 using only double
# and add? 10*b = double (b + double (double b)) = double (b + 4b) = double (5b).
# `size` compares the reduced trees; `Bench.run` compares reductions per call.
# `mul_const 10` specializes to the hand-written form, so it matches _mul10_spec.
_mul10       = Nat.mul 10
_mul10_const = Nat.mul_const 10
_mul10_spec  = \b Nat.double (Nat.add b (Nat.double (Nat.double b)))

_to_string = Nat.to_source
_mul10       7
# = 70
_mul10_const 7
# = 70
_mul10_spec  7
# = 70
size _mul10
# = 1047
size _mul10_const
# = 825
size _mul10_spec
# = 825

_to_string = id
Bench.run [_mul10;       7]
# = oh |  0a  0b   1   2 3a 3b 3c | alc red
#   25 | 136 264 356 364 15 11 42 | 400 788
Bench.run [_mul10_const; 7]
# = oh | 0a  0b   1   2 3a 3b 3c | alc red
#   16 | 88 182 236 241  8  8 31 | 270 524
Bench.run [_mul10_spec;  7]
# = oh | 0a  0b   1   2 3a 3b 3c | alc red
#   16 | 88 182 236 241  8  8 31 | 270 524
Bench.run [_mul10;       200]
# = oh |  0a  0b   1   2 3a 3b 3c | alc  red
#   37 | 248 479 639 657 30  8 81 | 727 1415
Bench.run [_mul10_const; 200]
# = oh |  0a  0b   1   2 3a 3b 3c | alc  red
#   28 | 200 397 519 534 23  5 70 | 597 1151
Bench.run [_mul10_spec;  200]
# = oh |  0a  0b   1   2 3a 3b 3c | alc  red
#   28 | 200 397 519 534 23  5 70 | 597 1151

# The same comparison for the constant-operand adder/subtractor chains
# (mul_const above answers it for multiplication): a partial application of the
# general add/sub drags the whole zip-and-ripple machinery along and re-walks
# the constant on every call, while add_const/sub_const reduce to a chain of
# one step per constant bit. Note the tree-size tradeoff on display: the chains
# roughly halve the reductions, but each owed position embeds both the
# carry/borrow continuations, so a dense constant's chain (sub_const 100 below)
# outgrows the shared general form it replaces.
_add48       = Nat.add '0'
_add48_const = Nat.add_const '0'
_sub100       = \a Nat.sub a 100
_sub100_const = Nat.sub_const 100

_to_string = Nat.to_source
size _add48
# = 792
size _add48_const
# = 576
size _sub100
# = 998
size _sub100_const
# = 2111

_to_string = id
Bench.run [_add48;       9]
# = oh | 0a  0b   1   2 3a 3b 3c | alc red
#   10 | 56 113 161 160 13  3 22 | 169 359
Bench.run [_add48_const; 9]
# = oh | 0a 0b  1  2 3a 3b 3c | alc red
#    0 | 12 12 20 20  1  0  4 |  24  45
Bench.run [_add48;       255]
# = oh | 0a  0b   1   2 3a 3b 3c | alc red
#   18 | 86 174 254 245 10 13 33 | 260 555
Bench.run [_add48_const; 255]
# = oh | 0a 0b   1   2 3a 3b 3c | alc red
#    9 | 40 72 102 102  2  6 11 | 112 223
Bench.run [_sub100;       255]
# = oh |  0a  0b   1   2 3a 3b 3c | alc  red
#   46 | 268 526 738 728 14 34 89 | 794 1603
Bench.run [_sub100_const; 255]
# = oh |  0a  0b   1   2 3a 3b 3c | alc  red
#   27 | 172 294 475 450 10 31 50 | 466 1016
