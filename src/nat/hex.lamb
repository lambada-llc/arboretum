# Both directions read the ASCII layout's bits instead of comparing against
# range bounds. Char -> value: '0'..'9' (48..57) carry their value in the low
# nibble, 'A'..'F' (65..70) and 'a'..'f' (97..102) carry value-9 there, and the
# letter blocks are exactly the code points with bit 6 set — so the value is
# the low nibble, plus 9 for chars at or past 64, with no comparison chain and
# no subtraction. Both match branches take the char as an argument, so only the
# selected range's conversion is computed.
_nibble = \c Nat.canonicalize (List.take 4 c)
_from_char = \c Bool.match (\c Nat.add_const 9 (_nibble c)) _nibble (Nat.is_zero (Nat.shr 6 c)) c
# Value -> char: '0' + n below ten and ('A' - 10) + n from ten up, one constant
# add either way. A nibble is ten or more exactly when bit 3 and (bit 1 or
# bit 2) are set — read off the bits rather than compared.
_is_ge_10 = List.match false (\_ \t List.match false (\b1 \t List.match false (\b2 \t List.match false (\b3 \_ Bool.and b3 (Bool.or b1 b2)) t) t) t)
_to_char = \n Bool.match (Nat.add_const '0') (Nat.add_const (Nat.sub 'A' 10)) (_is_ge_10 n) n
from_hex = Nat.from_string_base 16 _from_char
to_hex = Nat.to_string_pow2 4 _to_char
byte_to_hex = \byte [ _to_char (Nat.shr 4 byte); _to_char (List.take 4 byte) ]

_to_string = Nat.to_source
from_hex "0"
# = 0
from_hex "FF"
# = 255
from_hex "ff"
# = 255
from_hex "10"
# = 16
from_hex "DEADBEEF"
# = 3735928559

_to_string = String.to_source
to_hex 0
# = "0"
to_hex 255
# = "FF"
to_hex 16
# = "10"
to_hex 3735928559
# = "DEADBEEF"
byte_to_hex 0
# = "00"
byte_to_hex 15
# = "0F"
byte_to_hex 255
# = "FF"
byte_to_hex 171
# = "AB"
