# Conformance vectors: src/random/random.lamb against CPython's `random`
# module, which it claims to draw the same values as.
#
# The blocks below are, in order, the calls of this Python session:
#
#  import random
#  r = random.Random()
#  r.seed(0)
#  r.getrandbits(32)
#  r.getrandbits(8)
#  r.randrange(10)
#  a = list(range(5)); r.shuffle(a); a
#  [r.getrandbits(32) for _ in range(4)]
#  r.seed(87943260406273339520951041130787)
#  r.getrandbits(32)
#
# Each `# = ` line is what the call above it returns, and the NOTE names that
# call. The build rewrites those lines with what random.lamb computes, so
# disagreeing with CPython is a diff here; run the session to check the values
# themselves, but nothing has to run for the vectors to hold.
#
# Every call continues the state the one before it left, and each block spells
# that chain out from the seed rather than binding it to a name: a binding would
# be a symbol like any other, and one holding a seeded 624-word array is library
# content everything reading the bundle carries. Written out, the chain belongs
# to the tests, and hash-consing reduces the prefix they share once.

# r.seed(0)

_to_string = Nat.to_source
Pair.fst (Random.genrand_uint32
  (Random.seed 0))
# = 3626764237
# NOTE: must equal CPython's r.getrandbits(32)

Pair.fst (Random.getrandbits 8
  (Pair.snd (Random.genrand_uint32
  (Random.seed 0))))
# = 98
# NOTE: must equal CPython's r.getrandbits(8)

Pair.fst (Random.randbelow 10
  (Pair.snd (Random.getrandbits 8
  (Pair.snd (Random.genrand_uint32
  (Random.seed 0))))))
# = 6
# NOTE: must equal CPython's r.randrange(10)

_to_string = List.to_source Nat.to_source
Pair.fst (Random.shuffle (List.range 5)
  (Pair.snd (Random.randbelow 10
  (Pair.snd (Random.getrandbits 8
  (Pair.snd (Random.genrand_uint32
  (Random.seed 0))))))))
# = [4; 1; 3; 2; 0]
# NOTE: must equal CPython's r.shuffle over list(range(5))

Pair.fst (Random.gen_n 4
  (Pair.snd (Random.shuffle (List.range 5)
  (Pair.snd (Random.randbelow 10
  (Pair.snd (Random.getrandbits 8
  (Pair.snd (Random.genrand_uint32
  (Random.seed 0))))))))))
# = [1739178872; 3943786419; 3366389305; 3564191072]
# NOTE: must equal CPython's [r.getrandbits(32) for _ in range(4)]

# r.seed(87943260406273339520951041130787) — 0x456_00000345_00000234_00000123,
# four 32-bit words, so the key CPython builds from it is longer than the single
# word a small seed produces.

_to_string = Nat.to_source
Pair.fst (Random.genrand_uint32
  (Random.seed 87943260406273339520951041130787))
# = 1067595299
# NOTE: must equal CPython's r.getrandbits(32)
