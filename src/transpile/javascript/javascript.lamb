# Transpile a program into self-contained JavaScript.
#
# to_array renders a tree as a nested array literal, children rightmost first
# — the reverse of Serialize.js_array_encode. That order is what lets an
# array double as the evaluator's stack: applying a tree prepends the
# argument, and popping from the end walks down the operator spine.

to_array = \x (fix $ \self \x \rest △ '[' $ triage (\rest rest) self (\x \y \rest self y $ △ ',' $ self x rest) x $ △ ']' rest) x ""

# A program mapping its stdin to its stdout (string -> string) becomes a
# JavaScript arrow function doing the same, with no imports: the array
# literal, a dozen-line reduction loop, and string<->tree conversions on the
# way in and out.
of_stdin_stdout = \program List.concat_list ["arg => {
  const program = "; to_array program; ";
  // Read input string and turn it into a tree
  const ofB = b => b ? [[]] : [];
  const ofL = l => { let f = []; for (let i = l.length; i; i--) f = [f, l[i - 1]]; return f };
  const ofN = n => { let l = []; for (; n; n >>= 1) l.push(ofB(n % 2)); return ofL(l) };
  const ofS = s => ofL(Array.from(s, c => ofN(c.codePointAt(0))));
  const input = ofS(arg);
  // Apply program to input and execute
  const result = [input, ...program];
  const todo = [result];
  while (todo.length) {
    const f = todo.pop();
    if (f.length < 3) continue;
    todo.push(f);
    const a = f.pop(), b = f.pop(), c = f.pop();
    if (a.length === 0) f.push(...b);
    else if (a.length === 1) {
      const newPotRedex = [c, ...b];
      f.push(newPotRedex, c, ...a[0]);
      todo.push(newPotRedex);
    }
    else if (a.length === 2)
      if (c.length === 0) f.push(...a[1]);
      else if (c.length === 1) f.push(c[0], ...a[0]);
      else if (c.length === 2) f.push(c[0], c[1], ...b);
  }
  // Turn result into string
  const toB = f => !!f?.length;
  const toL = f => { let l = []; while (f?.length) { l.push(f[1]); f = f[0]; } return l };
  const toN = f => toL(f).reduceRight((acc, b) => 2 * acc + (toB(b) ? 1 : 0), 0);
  const toS = f => toL(f).map(toN).map(x => String.fromCodePoint(x)).join('');
  return toS(result); }"]

_to_string = String.to_source
to_array △
# = "[]"
to_array (△ △)
# = "[[]]"
to_array (△ △ △)
# = "[[],[]]"
to_array id
# = "[[],[[[]]]]"

# The identity program is cat.
△ (△ "cat.js" "text/javascript") $ of_stdin_stdout id
# = cat.js sha256:89553a6861ffce81c15d43384178b17f6bb68cbb22bad3f0908dd668ce55ab1c
