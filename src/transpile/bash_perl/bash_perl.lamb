# Transpile a program into a self-contained bash script mapping stdin to
# stdout. The program travels as Serialize.bitstr_encode's bitstring; Perl
# does the reduction, as PCRE substitutions — one literal string rewrite per
# reduction rule, plus three shortcuts that fuse an S step with the K step
# that follows when an operand is K-shaped, so an argument is only copied at
# genuine fan-out.

_bits = \program List.map (Bool.match '0' '1') $ Serialize.bitstr_encode program

# The reducer, one PCRE substitution per rule. A subterm is self-delimiting,
# so a capture group can match one by plain regex recursion; _a, _b, _c are
# such subterm captures, valid when a rule uses them in that order. The five
# reduction rules first (children of the argument's constructor stay in place,
# so a triage rule consumes only its prefix), then the three fused shortcuts,
# ordered before the general S rule they specialize.
_a = "(1|0(?1)(?1))"
_b = "(1|0(?2)(?2))"
_c = "(1|0(?3)(?3))"
_rule = \lhs \rhs List.concat_list ["s/"; List.concat_list lhs; "/"; rhs; "/g"]
_reduce = List.join ";"
  [ _rule ["0001001"; _a; _b; _c; "001"] "00$3"
  ; _rule ["0001001"; _a; _b; _c; "01"] "0$2"
  ; _rule ["0001001"; _a; _b; _c; "1"] "$1"
  ; _rule ["000101011"; _a; _b] "${2}"
  ; _rule ["0001010011"; _a; _b; _c] "0${1}0${2}${3}"
  ; _rule ["000101"; _a; "0011"; _b; _c] "00${1}${3}${2}"
  ; _rule ["000101"; _a; _b; _c] "00$1${3}0$2$3"
  ; _rule ["00011"; _a; _b] "$1"
  ]

of_stdin_stdout = \program List.concat_list ["#!/bin/bash
  set -euo pipefail
  program="; _bits program; "
  # Runtime
  function reduce {
    # 00011ab -> a
    # 000101abc -> 00ac0bc
    # 0001001abc1 -> a
    # 0001001abc01 -> 0b
    # 0001001abc001 -> 00c
    # Shortcuts (S fused with a K eliminator, i.e. rule 2 composed with rule 1):
    # 000101011bc -> c
    # 0001010011abc -> 0a0bc
    # 000101a0011bc -> 00acb
    perl -pe 'while($_=~/000/){"; _reduce; "}'
  }
  # Conversions: string <=> encoded tree
  function of_list () {
    while read -r line; do
      echo -n \"001$line\"
    done
    echo 1
  }
  function to_list () {
    sed 's/1$//' | perl -pe \"s/0(1|0(?1)(?1))/\\1\\n/g\" | sed -e 's/^01//g;$d'
  }
  function of_string () {
    perl -ne 'printf \"%vb\\n\", $_'  | tr . '\\n' | rev | sed 's/0/a/g;s/1/001011/g;s/a/0011/g;s/$/1/' | of_list
  }
  function to_string () {
    to_list | sed 's/1$//;s/0011/a/g;s/001011/1/g;s/a/0/g' | rev | echo \"ibase=2;$(cat)\" | bc | while read -r N; do printf \"\\\\$(printf '%03o' \"$N\")\"; done
  }
  
  fifo=$(mktemp -u)
  mkfifo \"$fifo\"
  (echo -n 0$program; of_string) | reduce \"$fifo\" | to_string
  rm -f \"$fifo\"
 "
 ]

# The identity program is cat.
△ (△ "cat.sh" "text/x-shellscript") $ of_stdin_stdout id
# = cat.sh sha256:55190358d0022c24eff020930d8f8ad7b071ff098ba1625fedbd4a1baaea6142
