# size :: tree -> snat (count of nodes)
_s = \a \b \c a c $ b c
_triage = \self triage id self $ \u
      _s
        (\v compose (self v))
        (\v self u)
_functional_smallest = \self \x compose Snat.succ $ _triage self x
size__smallest = \x (fix _functional_smallest) x Snat.zero

# size__smallest is search-verified minimal at 125 nodes: seed wrapper (5) + fix knot
# (44: the 17-node unfolder _h below, paid twice) + body (76). Exhaustive enumeration
# (~150M candidates: all knot unfolders to 16 nodes, wrapper/dispatch shells to 14,
# fork-case replacements to enum-15 with combinator atoms, every normal-form subtree
# against all trees up to 11 nodes) plus ~60 reformulations through the compiler
# (best alternative: 129) found nothing smaller, but surfaced five independent
# same-size substitution sites — 31 sibling 125-node normal forms. One per site:
#  _j for id as the leaf case                              (size__smallest2)
#  _hj for _h in either knot slot                          (size__smallest3/4)
#  _b2 for compose at either fork-case composition site    (size__smallest5/6)
_j = △ (△ △ △) △
_b2 = △ (△ (△ △ △)) (△ (△ (△ △ △)) (△ △))
_h = △ (△ (△ △ (△ (△ (△ (△ (△ (△ (△ △)) △)) (△ △)))))) (△ △)
_hj = △ (△ (△ △ (△ (△ (△ (△ (△ (△ △ △) △)) (△ △)))))) (△ △)
_f2 = \self \x compose Snat.succ $ triage _j self (\u _s (\v compose (self v)) (\v self u)) x
size__smallest2 = \x (fix _f2) x Snat.zero
size__smallest3 = △ (△ (△ (△ _hj) (△ △ (△ (△ (△ △ _functional_smallest)) (△ (△ _h)))))) (△ △ △)
size__smallest4 = △ (△ (△ (△ _h) (△ △ (△ (△ (△ △ _functional_smallest)) (△ (△ _hj)))))) (△ △ △)
_f5 = \self \x compose Snat.succ $ triage id self (\u _s (\v _b2 (self v)) (\v self u)) x
size__smallest5 = \x (fix _f5) x Snat.zero
_q6 = △ (△ (△ (△ (△ △ _b2)) (△ (△ (△ △ _s)) (△ (△ (△ △ compose)))))) (△ (△ (△ △ (△ △))))
_f6 = \self \x compose Snat.succ $ triage id self (_q6 self) x
size__smallest6 = \x (fix _f6) x Snat.zero

# Smaller still, once the program no longer has to terminate under eager
# evaluation. Nathan Farlow found these by deleting subtrees of a known program
# — sometimes several at once — and searching for smaller replacements
# (lambada-llc/tree-calculus#20). Every one of them hangs an eager evaluator,
# which is what __lazy marks, so they are applied through Reflect.lazy_eval: it
# reduces in normal order and so returns on anything that has a normal form at
# all, while terminating eagerly itself, which is what lets this repository keep
# its rule and still run them. They are named by node count rather than by rank,
# so that finding a smaller one adds a line instead of renumbering the rest.
#
# They are not one family. _lazy_body is what the 108 and the 113 have in common
# (and 79 nodes of it is shared with size__smallest, which is where those two
# were carved from); _lazy_body2 is a different architecture altogether. The 103
# and the 106 share only 30 nodes with each other, and little with anything
# else, so they are written out whole.
_lazy_body = △ △ (△ (△ (△ △ (△ (△ (△ △ (△ (△ (△ △ (△ (△ (△ △ △)))))))) (△ (△ (△ (△ (△ △ △)) (△ (△ (△ (△ △)) △)))) (△ (△ (△ (△ (△ △ (△ (△ (△ △ (△ (△ (△ △ △)) △))) (△ △)))) (△ (△ (△ △ (△ (△ (△ △ △)) △))) (△ (△ (△ △ (△ (△ (△ △ (△ (△ (△ △ △)) △))) (△ △)))))))) (△ (△ (△ △ (△ △))))))))) (△ (△ (△ (△ △) △)) △))
_lazy_body2 = △ (△ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ (△ (△ △ (△ △))) (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ △))))))) (△ △ (△ (△ (△ (△ (△ △ △)) (△ (△ △) △))) (△ (△ (△ △ (△ (△ (△ △ △))))) △)))
size__lazy_100 = △ (△ (△ (△ (△ △ (△ (△ (△ (△ (△ △)) △)) (△ △)))) (△ △ (△ (△ (△ △ (△ (△ (△ △ (△ (△ △ △)))) _lazy_body2))) (△ (△ (△ △ (△ (△ (△ △ △))))) (△ (△ (△ (△ △) △)) △)))))) (△ △)
size__lazy_103 = △ (△ (△ (△ (△ △ (△ (△ (△ (△ △))) (△ (△ (△ △ (△ △))) (△ (△ (△ △ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ △)))))))))) (△ △ (△ (△ (△ △ (△ (△ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ (△ (△ △ (△ (△ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ (△ (△ △ (△ (△ (△ △ △))))) (△ (△ (△ △ △)) △)))))))) (△ △))))) (△ (△ (△ (△ (△ △)) △)) (△ △ △))))) (△ (△ (△ (△ △) △)) △))))) (△ △)
size__lazy_104 = △ (△ (△ (△ (△ △ (△ (△ (△ (△ (△ △)) △)) (△ △)))) (△ △ (△ (△ (△ △ (△ (△ (△ △ (△ (△ △ △)))) (△ (△ (△ △ (△ (△ (△ △ (△ (△ (△ △ △)))))))) _lazy_body2)))) (△ (△ (△ (△ △) △)) △))))) (△ △)
size__lazy_106 = △ (△ (△ (△ (△ △ (△ (△ (△ (△ △))) (△ △)))) (△ △ (△ (△ (△ △ (△ (△ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ (△ (△ △ (△ (△ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ (△ (△ △ (△ (△ (△ △ △))))) (△ (△ (△ △ △)) △)))))))) (△ (△ (△ △ (△ △))) (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ △)))))))) (△ (△ (△ (△ (△ △ △)) (△ (△ (△ △ △)) (△ △)))) (△ △ △))))) (△ (△ (△ (△ △) △)) △))))) (△ △)
size__lazy_108 = △ (△ (△ (△ (△ △ (△ (△ (△ (△ △))) (△ △)))) _lazy_body)) (△ (△ △) (△ △ △))
size__lazy_113 = △ (△ (△ (△ (△ (△ (△ △ (△ (△ (△ (△ (△ (△ (△ △)) △)) (△ △)))))) (△ △))) _lazy_body)) (△ △ △)
size__smallest__lazy = size__lazy_100
_size_body = \self \x compose △ $ triage (\self id) (\u \self self self u) (\v \u \self compose (self self u) (self self v)) x self
size__fastest = \x (self_apply _size_body) x △
size = \x (wait self_apply _size_body) x △

# Certify.computes_size proves a program returns its argument's node count for
# every tree, by reading it as the tree it is; src/certify/size.lamb has the how.
_to_string = Bool.to_source
Certify.computes_size size
# = true
Certify.computes_size size__fastest
# = true
Certify.computes_size size__smallest
# = true
Certify.computes_size size__smallest2
# = true
Certify.computes_size size__smallest3
# = true
Certify.computes_size size__smallest4
# = true
Certify.computes_size size__smallest5
# = true
Certify.computes_size size__smallest6
# = true

# A true stands on a proof, and the proof is an induction tree that can be
# looked at: Certify.certify_size returns it, Certify.render draws it. For
# the minimal program — SPLIT with a case per shape of the split variable,
# PEEL per emitted successor, GEN naming a subterm's count, FOLD closing an
# instance of an induction hypothesis.
_to_string = Option.to_source id
Option.map Certify.render (Certify.certify_size size__smallest)
# = (some (SPLIT t0 (PEEL ZERO) (GEN g11 (PEEL (VALUE g11))) (GEN g12 (CUT [g12] (PEEL (SPLIT t01 (PEEL END) (PEEL FOLD) (CUT [|t010|,*k12515] (PEEL FOLD*)))) (VALUE g12)))))
_to_string = Bool.to_source

# Certify.computes_size_eagerly proves that and more: that reduction terminates
# in every order, so these are `size` for an evaluator that reduces arguments
# before it uses them, which is what this repository's rule asks of them. The
# eight above are written to that rule and pass.
Certify.computes_size_eagerly size
# = true
Certify.computes_size_eagerly size__fastest
# = true
Certify.computes_size_eagerly size__smallest
# = true
Certify.computes_size_eagerly size__smallest2
# = true
Certify.computes_size_eagerly size__smallest3
# = true
Certify.computes_size_eagerly size__smallest4
# = true
Certify.computes_size_eagerly size__smallest5
# = true
Certify.computes_size_eagerly size__smallest6
# = true

# And it is what the __lazy ones fail, on the very first state: reducing them
# eagerly under a variable input spends the whole budget without reaching a
# normal form, which is the same wall an eager evaluator hits on a real one.
# That is what separates the two families here, read off the programs rather
# than taken on faith — and what the naming, the lazy_eval below and the node
# counts at the bottom are all about.
Certify.computes_size_eagerly size__lazy_100
# = false
Certify.computes_size_eagerly size__lazy_103
# = false
Certify.computes_size_eagerly size__lazy_104
# = false
Certify.computes_size_eagerly size__lazy_106
# = false
Certify.computes_size_eagerly size__lazy_108
# = false
Certify.computes_size_eagerly size__lazy_113
# = false

# Certify.computes_size asks only for the count, in normal order, and its
# extended rule system (src/certify/size.lamb) closes over two of them: the
# induction abstracts away the input copies their states drag one constructor
# behind the live one, and a tail atom caps the spec their left-nested forks
# would otherwise grow without bound. A true is a proof that the program
# returns its argument's node count on every tree — which is more than any
# run of it below can say.
Certify.computes_size size__lazy_100
# = true
Certify.computes_size size__lazy_103
# = false
Certify.computes_size size__lazy_104
# = true
Certify.computes_size size__lazy_106
# = false
Certify.computes_size size__lazy_108
# = false
Certify.computes_size size__lazy_113
# = false

# The 100's certificate, drawn. This is what the extended rules exist for —
# no eager program's proof tree has a CUT against a ⟨★k⟩ tail, an END
# recording where a phase stopped, an ABSTRACT stripping lag junk, or a
# FOLD* whose borrowed tail the second pass re-checked.
_to_string = Option.to_source id
Option.map Certify.render (Certify.certify_size size__lazy_100)
# = (some (SPLIT t0 (PEEL ZERO) (PEEL (ABSTRACT j11661 (SPLIT t00 (PEEL ZERO) (PEEL FOLD) (CUT [|t000|] (PEEL (SPLIT t001 (PEEL END) (PEEL FOLD) (CUT [|t0010|,*k11666215] (PEEL (ABSTRACT j116662157662357660 (SPLIT t0011 (PEEL END) (PEEL FOLD) (CUT [|t00110|,*k11666215766235] (PEEL FOLD*))))) FOLD))) FOLD)))) (CUT [|t00|] (PEEL (SPLIT t01 (PEEL END) (PEEL (ABSTRACT j12157661661 (SPLIT t010 (PEEL END) (PEEL FOLD) (CUT [|t0100|,*k1215] (PEEL (ABSTRACT j121576616662557660 (SPLIT t0101 (PEEL END) (PEEL FOLD) (CUT [|t01010|,*k12157661666255] (PEEL FOLD*))))) FOLD)))) (CUT [|t010|,*k1215] (PEEL (ABSTRACT j12157662357661,j12157662357662 (SPLIT t011 (PEEL END) (PEEL FOLD) (CUT [|t0110|,*k1215766235] (PEEL FOLD*))))) (ABSTRACT j1215766235801 (SPLIT t010 (PEEL END) (PEEL FOLD) (CUT [|t0100|,*k1215] (PEEL (ABSTRACT j12157662358062557660 (SPLIT t0101 (PEEL END) (PEEL FOLD) (CUT [|t01010|,*k1215766235806255] (PEEL FOLD*))))) FOLD)))))) (ABSTRACT j1215801 (SPLIT t00 (PEEL ZERO) (PEEL FOLD) (CUT [|t000|] (PEEL (SPLIT t001 (PEEL END) (PEEL FOLD) (CUT [|t0010|,*k1215806215] (PEEL (ABSTRACT j12158062157662357660 (SPLIT t0011 (PEEL END) (PEEL FOLD) (CUT [|t00110|,*k1215806215766235] (PEEL FOLD*))))) FOLD))) FOLD))) (ABSTRACT j1215811 (SPLIT t00 (PEEL ZERO) (PEEL FOLD) (CUT [|t000|] (PEEL (SPLIT t001 (PEEL END) (PEEL FOLD) (CUT [|t0010|,*k1215816215] (PEEL (ABSTRACT j12158162157662357660 (SPLIT t0011 (PEEL END) (PEEL FOLD) (CUT [|t00110|,*k1215816215766235] (PEEL FOLD*))))) FOLD))) FOLD))) (ABSTRACT j1215821 (SPLIT t00 (PEEL ZERO) (PEEL FOLD) (CUT [|t000|] (PEEL (SPLIT t001 (PEEL END) (PEEL FOLD) (CUT [|t0010|,*k1215826215] (PEEL (ABSTRACT j12158262157662357660 (SPLIT t0011 (PEEL END) (PEEL FOLD) (CUT [|t00110|,*k1215826215766235] (PEEL FOLD*))))) FOLD))) FOLD))))))
_to_string = Bool.to_source

# The remaining falses are the certifier being conservative, not a finding:
# false has always meant "no proof within bounds" here, and the 103, 106, 108
# and 113 defeat its junk and continuation heuristics within its depth. All
# six run at all only because the certifier reduces over spines
# (src/quoted/spine.lamb): reading the 103 and the 106 through the
# term-rebuilding evaluator did not come back under this build's eager
# runner, which made the analysis a program this repository could not run on
# its own subject matter.
#
# For the 100 and the 104 the count claim is proven above. For the other four
# nothing here establishes they are `size`; what is left of that claim is one
# input apiece below, which is a smoke test and not much more — `_deep_bug`
# in src/certify/test.lamb is not `size`, and returns 5 on it too.
_to_string = Snat.to_string
Reflect.lazy_eval size__smallest__lazy id
# = 5
Reflect.lazy_eval size__lazy_103 id
# = 5
Reflect.lazy_eval size__lazy_104 id
# = 5
Reflect.lazy_eval size__lazy_106 id
# = 5
Reflect.lazy_eval size__lazy_108 id
# = 5
Reflect.lazy_eval size__lazy_113 id
# = 5

# Node counts, which is what the __lazy ones are named after.
size size__smallest
# = 125
size size__smallest2
# = 125
size size__smallest3
# = 125
size size__smallest4
# = 125
size size__smallest5
# = 125
size size__smallest6
# = 125
size size__lazy_100
# = 100
size size__lazy_103
# = 103
size size__lazy_104
# = 104
size size__lazy_106
# = 106
size size__lazy_108
# = 108
size size__lazy_113
# = 113
